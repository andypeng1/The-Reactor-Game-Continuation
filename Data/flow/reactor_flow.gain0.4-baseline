#
## SECTION 1 -- every branch of Engine:Command, and every Repair kind, taken
## exhaustively. SET is the precondition written by hand; DELT is what the call
## itself changed. A DENY with an empty DELT is a refusal that mutates nothing.
GATE 1   boot, monitor power off                  DENY Power monitors and open shutters first
SET  -
DELT -
GATE 2   boot, shutters closed                    DENY Power monitors and open shutters first
SET  monitorPower=true
DELT -
GATE 3   boot accepted                            OK
SET  monitorPower=true shuttersOpen=true
DELT s.phase:Cold>Booting
GATE 4   boot while Booting                       DENY Boot already running or reactor active
SET  monitorPower=true phase=Booting shuttersOpen=true
DELT -
GATE 5   boot while Running                       DENY Boot already running or reactor active
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 6   monitor_power off from Cold              OK
SET  monitorPower=true
DELT s.monitorPower:true>false
GATE 7   monitor_power off while Booting          OK
SET  monitorPower=true phase=Booting shuttersOpen=true
DELT s.monitorPower:true>false s.phase:Booting>Cold
GATE 8   monitor_power off while Ready            OK
SET  booted=true monitorPower=true phase=Ready shuttersOpen=true
DELT s.booted:true>false s.monitorPower:true>false s.phase:Ready>Cold
GATE 9   monitor_power off while Running          OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.booted:true>false s.monitorPower:true>false
GATE 10  start, nothing booted                    DENY Complete control room boot first
SET  -
DELT -
GATE 11  start at Ready                           OK
SET  booted=true monitorPower=true phase=Ready shuttersOpen=true
DELT s.phase:Ready>Starting
GATE 12  shutters toggle from Cold                OK
SET  -
DELT s.shuttersOpen:false>true
GATE 13  lights toggle from Cold                  OK
SET  -
DELT s.lights:true>false
GATE 14  mute toggle from Cold                    OK
SET  -
DELT s.mute:false>true
GATE 15  shutdown while Cold                      DENY Reactor is not running
SET  -
DELT -
GATE 16  shutdown while Starting                  DENY Reactor is not running
SET  monitorPower=true phase=Starting shuttersOpen=true
DELT -
GATE 17  shutdown, quota unmet                    DENY Energy quota not yet met
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 18  shutdown, core exactly at the limit      DENY Cool reactor below 17000 F first
SET  booted=true cbl[1..3].active=true energy=512 monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=17000
DELT -
GATE 19  shutdown, core one degree under          OK
SET  booted=true cbl[1..3].active=true energy=512 monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=16999
DELT s.cbl[1].active:true>false s.cbl[2].active:true>false s.cbl[3].active:true>false s.phase:Running>Stopping
GATE 20  shutdown accepted                        OK
SET  booted=true cbl[1..3].active=true energy=512 monitorPower=true phase=Running pressure=5000 sam=true shuttersOpen=true temperature=12000
DELT s.cbl[1].active:true>false s.cbl[2].active:true>false s.cbl[3].active:true>false s.phase:Running>Stopping s.sam:true>false
GATE 21  next while Running                       DENY No next shift available
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 22  next at Report, shift 1 of 3             OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Report pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 23  next at Report, shift 3 of 3             DENY No next shift available
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Report pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 24  reset at Report                          OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Report pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 25  reset while Failed                       OK
SET  booted=true cbl[1..3].active=true failure=probe monitorPower=true phase=Failed pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 26  reset while Running                      DENY Cannot reset an active shift
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 27  fan while Report                         DENY Shift ended
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Report pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 28  fan while Failed                         DENY Shift ended
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Failed pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 29  fan index 0                              DENY Invalid device index
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 30  fan index 7                              DENY Invalid device index
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 31  fan index 1.5                            DENY Invalid device index
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 32  cbl level 0                              DENY Invalid CBL level
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
