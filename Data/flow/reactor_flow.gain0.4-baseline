SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 34  cbl level 5                              OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.cbl[1].level:2>5
GATE 35  cbl on a faulted device                  DENY CBL requires repair
SET  booted=true cbl[1..3].active=true cbl[1].fault=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 36  pump_level 4                             DENY Invalid coolant level
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 37  pump_level 2                             OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.pumps[1].level:1>2
GATE 38  pump_on, intact                          OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.pumps[1].enabled:false>true
GATE 39  pump_on, depleted                        DENY Coolant pump requires repair
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 pumps[1].integrity=0 shuttersOpen=true temperature=9420
DELT -
GATE 40  pump_off                                 OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 pumps[1].enabled=true shuttersOpen=true temperature=9420
DELT s.pumps[1].enabled:true>false
GATE 41  extraction 5                             DENY Invalid extraction level
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 42  extraction 4                             OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.extraction:2>4
GATE 43  cbl_purge                                OK
SET  booted=true cbl[1..3].active=true cbl[1].pressure=50 cbl[1].stress=30 monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.cbl[1].pressure:50>0 s.cbl[1].purgeUntil:0>4 s.cbl[1].stress:30>5
GATE 44  cbl_purge in cooldown                    DENY CBL purge cooling down
SET  booted=true cbl[1..3].active=true cbl[1].purgeUntil=time+10 monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 45  hdef on                                  OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.hdef.enabled:false>true
GATE 46  hdef on a faulted generator              DENY HDEF requires repair
SET  booted=true cbl[1..3].active=true hdef.fault=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 47  mass_toggle 1                            OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.mass[1].enabled:false>true
GATE 48  mass_level 1                             OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.mass[1].level:1>2
GATE 49  sam while Cold                           DENY SAM unavailable
SET  -
DELT -
GATE 50  sam while Running                        OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.sam:false>true
GATE 51  sam, radiation at the limit              OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 radiation=600 shuttersOpen=true temperature=9420
DELT s.sam:false>true
GATE 52  atmosphere_vent while Cold               DENY Reactor is not running
SET  -
DELT -
GATE 53  atmosphere_vent while Running            OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.pressure:5000>2000 s.ventUntil:0>26
GATE 54  atmosphere_vent during Equinox           DENY Pressure control unavailable during Equinox
SET  booted=true cbl[1..3].active=true equinox=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 55  atmosphere_vent in cooldown              DENY Atmosphere vent cooling down
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420 ventUntil=time+10
DELT -
GATE 56  emergency_vent                           OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.emergencyUsed[1]:false>true s.fluctuation:0>-7000 s.temperature:9420>2420
GATE 57  emergency_vent, already spent            DENY Emergency vent depleted for this shift
SET  booted=true cbl[1..3].active=true emergencyUsed[1]=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 58  emergency_vent index 4                   DENY Invalid device index
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 59  grav_charge in shift 1                   DENY Gravatron overcharge requires shift 3 operation
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 60  grav_charge in shift 3                   OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.grav.phase:Idle>Charging
GATE 61  grav_charge while Charging               DENY Overcharge already in progress
SET  booted=true cbl[1..3].active=true grav.phase=Charging monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 62  grav_fire while Idle                     DENY Gravatron not charging
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 63  grav_fire inside the window              OK
SET  booted=true cbl[1..3].active=true grav.charge=7 grav.phase=Armed monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.grav.charge:7>0 s.grav.damage:0>5 s.grav.phase:Armed>Idle
GATE 64  repair_pump through Command              DENY Unknown control: repair_pump
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
GATE 65  unknown action                           DENY Unknown control: widget
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
REP  66  repair pump                              OK
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 pumps[1].integrity=40 shuttersOpen=true temperature=9420
DELT s.pumps[1].integrity:40>50
REP  67  repair pump, seconds 0                   DENY rejected
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 pumps[1].integrity=40 shuttersOpen=true temperature=9420
DELT -
REP  68  repair pump, seconds 2                   DENY rejected
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 pumps[1].integrity=40 shuttersOpen=true temperature=9420
DELT -
REP  69  repair pump, index 4                     DENY rejected
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
REP  70  repair cbl clears the fault              OK
SET  booted=true cbl[1..3].active=true cbl[1].active=false cbl[1].fault=true cbl[1].stress=10 monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.cbl[1].active:false>true s.cbl[1].fault:true>false s.cbl[1].stress:10>0
REP  71  repair grav                              OK
SET  booted=true cbl[1..3].active=true grav.damage=30 monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.grav.damage:30>20
REP  72  repair hdef clears the fault             OK
SET  booted=true cbl[1..3].active=true hdef.fault=true hdef.heat=5 monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT s.hdef.fault:true>false s.hdef.heat:5>0
REP  73  repair unknown kind                      DENY rejected
SET  booted=true cbl[1..3].active=true monitorPower=true phase=Running pressure=5000 shuttersOpen=true temperature=9420
DELT -
