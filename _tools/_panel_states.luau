--!nocheck
-- GENERATED by _tools/build_panel_test.py -- edit that file, not this one.
--
-- snapshot() and reportUnattributed() below are EXTRACTED from
-- _tools/TRG_original_recorder.luau. Everything else is mock; no Roblox API and
-- no DataModel instance is touched.

local results = {}
local function say(s) results[#results + 1] = tostring(s) end

local emitLines = {}
local function emitEvt(kind, rest)
	emitLines[#emitLines + 1] = kind .. ' ' .. tostring(rest)
end

local Config = {
	MaxPanelLabels = 200,
	MaxPanelChars = 1200,
	AttribWindowPolls = 8,
}

local changedCtrl = {}
local clickPoll = nil
local sample = 0

-- A TextLabel good enough for snapshot: it asks for Name, Text and IsA, and
-- nothing else. GetDescendants returns whatever order the caller dictates,
-- which is the point -- a test that could not vary the order could not test the
-- property that matters.
local function mkLabel(name, text)
	return {
		Name = name,
		Text = text,
		IsA = function(_, c) return c == 'TextLabel' end,
	}
end

local function rootOf(labels, order)
	if order == nil then
		order = {}
		for i = 1, #labels do order[i] = i end
	end
	return {
		GetDescendants = function()
			local out = {}
			for i = 1, #order do out[i] = labels[order[i]] end
			return out
		end,
	}
end

local function snapshot(root)
	if root == nil then return nil, 0 end
	local rows = {}
	local ok = pcall(function()
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA('TextLabel') then
				local t = d.Text
				if type(t) == 'string' and t ~= '' then
					rows[#rows + 1] = d.Name .. '=' .. (t:gsub('%s+', ' '))
				end
			end
		end
	end)
	if not ok then return '<unreadable>', 0 end
	if #rows == 0 then return '<no text>', 0 end
	table.sort(rows)
	local n, out, total = #rows, {}, 0
	for i = 1, n do
		if i > Config.MaxPanelLabels then
			out[#out + 1] = '<' .. tostring(n - Config.MaxPanelLabels) .. ' more>'
			break
		end
		total = total + #rows[i] + 1
		if total > Config.MaxPanelChars then
			out[#out + 1] = '<truncated>'
			break
		end
		out[#out + 1] = rows[i]
	end
	return table.concat(out, '|'), n
end

local function reportUnattributed()
	for i = 1, #changedCtrl do
		local rec = changedCtrl[i]
		-- Derived aggregates are skipped: fanCount is the sum of the six fans
		-- that are each already reported, so it would double every fan change
		-- and call one cause two.
		if string.sub(rec.key, -5) ~= 'Count' and string.sub(rec.key, -3) ~= 'Sum' then
			-- Written as an if, not as `and nil or`. That idiom returns its
			-- middle operand only when the middle is truthy, so with nil in the
			-- middle it can never yield nil -- and yielding nil is the whole
			-- point here, because "this client has never seen a click" is the
			-- 18:01 case this section exists for. The compact form evaluated
			-- `sample - nil` and threw on the first call.
			local since = nil
			if clickPoll ~= nil then since = sample - clickPoll end
			if since == nil or since > Config.AttribWindowPolls then
				local how = (since == nil) and 'no click seen yet'
					or ('last click ' .. tostring(since) .. ' polls ago')
				emitEvt('UNATTR', rec.key .. ' ' .. tostring(rec.from) .. '->' ..
					tostring(rec.to) .. ' (' .. how .. ')')
			end
		end
	end
end

-- ============================ THE CHECKS ==================================
local function check(name, got, want)
	local ok = (got == want)
	say((ok and 'PASS ' or 'FAIL ') .. name)
	if not ok then
		say('     got  [' .. tostring(got) .. ']')
		say('     want [' .. tostring(want) .. ']')
	end
end

local function checkTrue(name, cond, why)
	say((cond and 'PASS ' or 'FAIL ') .. name)
	if not cond then say('     ' .. why) end
end

local function join(t) return table.concat(t, ' ; ') end

-- ------------------------------------------------------------- ORDER ------
-- Same three labels, three different enumeration orders. The snapshot must be
-- byte-identical for all three.
local L = {
	mkLabel('TimeLabel', '3'),
	mkLabel('StressLabel', '12'),
	mkLabel('TempLabel', '4183'),
	mkLabel('', ''),
}
local a = snapshot(rootOf(L, { 1, 2, 3, 4 }))
local b = snapshot(rootOf(L, { 3, 1, 4, 2 }))
local c = snapshot(rootOf(L, { 2, 4, 3, 1 }))
checkTrue('P1 snapshot ignores enumeration order', a == b and b == c,
	'the three orders disagreed, so the snapshot is not a function of contents')
check('P1 snapshot content', a, 'StressLabel=12|TempLabel=4183|TimeLabel=3')

-- ------------------------------------------------------------- CHANGE -----
-- The complement of P1: the snapshot must NOT be constant. One label changing
-- text is a change, and it has to survive the sort -- a snapshot compared
-- against itself after sorting would be constant and pass P1 for the wrong
-- reason.
local L2 = {
	mkLabel('TimeLabel', '4'),
	mkLabel('StressLabel', '12'),
	mkLabel('TempLabel', '4183'),
}
local moved = snapshot(rootOf(L2, { 3, 2, 1 }))
checkTrue('P2 a real content change is visible', moved ~= a,
	'TimeLabel went 3 -> 4 and the snapshot did not move: ' .. tostring(moved))

-- ---------------------------------------------------------- EMPTY / NIL ---
check('P3 nil root is nil', tostring(snapshot(nil)), 'nil')
local blanks = { mkLabel('A', ''), mkLabel('B', ''), mkLabel('C', nil) }
check('P3 all-empty root', snapshot(rootOf(blanks, nil)), '<no text>')

-- ------------------------------------------------------------ TRUNCATION --
-- The two caps are tested separately, and each with the OTHER one lifted out of
-- the way. Run together they interact: whichever cap is reached first wins, so
-- 250 short rows trip the character cap at row 235 and the assertion written for
-- the row cap would be asserting on the character cap's marker. That failure was
-- real and is why this is two scenarios and not one.
--
-- `find(..., 1, true)` is the plain-text form. A Lua `find` is a PATTERN search,
-- and `%%` in a pattern is an escaped literal `%`, so a needle of `%%<50 more>%%`
-- can never match the snapshot it was written to look for -- it fails as a
-- pattern bug, in a test, on the assertion that is checking for a missing marker.
local keepLabels, keepChars = Config.MaxPanelLabels, Config.MaxPanelChars

local many = {}
for i = 1, keepLabels + 50 do many[i] = mkLabel('Row', tostring(i)) end
Config.MaxPanelChars = 1e9          -- so the ROW cap is the one under test
local s = snapshot(rootOf(many, nil))
Config.MaxPanelChars = keepChars
checkTrue('P4 row cap bites', string.find(s, '<50 more>', 1, true) ~= nil,
	'250 rows with a cap of 200 did not report 50 more: ' .. string.sub(s, -40))
-- Bounded means the row count is exactly the cap, not merely "short": one row
-- per item plus the marker, and one `|` between each pair.
check('P4 row cap is exact',
	select(2, s:gsub('|', '')), keepLabels)
checkTrue('P4 row-capped length is bounded', #s < 2000,
	'the capped snapshot was longer than the rows it kept: ' .. tostring(#s))

local fat = {}
for i = 1, 30 do fat[i] = mkLabel('Row' .. tostring(i), string.rep('x', 100)) end
local s2 = snapshot(rootOf(fat, nil))
checkTrue('P4 char cap bites', string.find(s2, '<truncated>', 1, true) ~= nil,
	'3000 characters of rows were not truncated at ' .. tostring(keepChars))
-- The loop tests the budget BEFORE adding, so the last row can overshoot by up
-- to its own length plus the marker. That is the honest bound; asserting `#s2 <=
-- cap` would fail on a correct snapshot, which is how a too-tight assertion gets
-- "fixed" by loosening the code it is checking.
checkTrue('P4 char cap is honoured', #s2 <= keepChars + 100 + 16,
	'the truncated snapshot was ' .. tostring(#s2) .. ' bytes')

-- ----------------------------------------------------------- ATTRIBUTION --
local function unattr(nCtrl, clickAgePolls, nilClick)
	changedCtrl = nCtrl
	sample = 100
	clickPoll = nil
	if not nilClick then clickPoll = 100 - clickAgePolls end
	emitLines = {}
	reportUnattributed()
	return join(emitLines)
end

-- A change 3 polls after a click is the click's doing. Silence.
check('P5 click 3 polls ago is attributed', unattr(
	{ { key = 'c.cbl1Lvl', from = 2, to = 1 } }, 3, false), '')

-- A change 30 polls after the last click is not. One line, naming the FROM.
check('P5 click 30 polls ago is unattributed', unattr(
	{ { key = 'c.cbl1Lvl', from = 2, to = 1 } }, 30, false),
	'UNATTR c.cbl1Lvl 2->1 (last click 30 polls ago)')

-- No click seen at all is the 18:01 case: the recorder was injected and the
-- plant was already being operated by something it could not see.
check('P5 no click ever', unattr(
	{ { key = 'c.cbl2Lvl', from = 5, to = 1 } }, 0, true),
	'UNATTR c.cbl2Lvl 5->1 (no click seen yet)')

-- Derived aggregates must not double-report the six fans as one cause.
check('P5 fanCount is skipped', unattr(
	{ { key = 'c.fanCount', from = 6, to = 5 } }, 30, false), '')
check('P5 coolSum is skipped', unattr(
	{ { key = 'c.coolSum', from = 3, to = 2 } }, 30, false), '')

-- Several controls in one poll: one line each, in the order they changed.
check('P5 many controls, one line each', unattr({
	{ key = 'c.fan4', from = 1, to = 0 },
	{ key = 'c.fanCount', from = 4, to = 3 },
	{ key = 'c.cbl1Lvl', from = 2, to = 1 },
}, 30, false),
	'UNATTR c.fan4 1->0 (last click 30 polls ago) ; '
	.. 'UNATTR c.cbl1Lvl 2->1 (last click 30 polls ago)')

-- A boolean reads as a boolean, not as `nil` -- the 3-way case of a value that
-- was false, which `tostring` handles and a truthiness test would not.
check('P6 a false FROM is printed', unattr(
	{ { key = 'c.vent1', from = false, to = true } }, 30, false),
	'UNATTR c.vent1 false->true (last click 30 polls ago)')

-- The window is inclusive at the top: exactly AttribWindowPolls is still
-- attributed. This pins the boundary rather than the middle of the range.
check('P6 the window edge is exact', unattr(
	{ { key = 'c.fan1', from = 1, to = 0 } }, Config.AttribWindowPolls, false), '')
check('P6 one past the edge', unattr(
	{ { key = 'c.fan1', from = 1, to = 0 } }, Config.AttribWindowPolls + 1, false),
	'UNATTR c.fan1 1->0 (last click 9 polls ago)')

-- Returned, not printed: this runs through a boundary that shows a chunk's
-- return value and not necessarily its console.
local report = table.concat(results, string.char(10))

-- And an exit code as well, because a harness whose failure is only a word on a
-- page passes in every script that runs it. Guarded rather than unconditional:
-- `io` and `os.exit` exist in the standalone interpreter and not in Studio's
-- Luau, and a harness that dies with "attempt to index nil" on its FAILURE path
-- reports the wrong reason for the right result.
if string.find(report, 'FAIL', 1, true) ~= nil and io ~= nil and io.stderr ~= nil then
	io.stderr:write(report .. string.char(10))
	os.exit(1)
end
return report
