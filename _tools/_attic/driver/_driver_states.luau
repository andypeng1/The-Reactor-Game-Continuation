local results = {}
local function say(s) results[#results + 1] = tostring(s) end
-- driveStep calls this on every transition. It is part of the mock surface, and
-- leaving it out is not a small omission: the harness would die on the first
-- state change and every scenario would report as a failure of the driver.
local function emitEvt(kind, rest) say('     evt ' .. kind .. ' ' .. tostring(rest)) end

local Config = {
	SampleInterval = 0.25,
	AutoDrive = false,
	DriveArmSeconds = 20,
	DriveHoldSeconds = 60,
	DriveProveSeconds = 40,
	DriveColdSeconds = 30,
	-- Mirrors the shipped default. The driver reads this to decide whether a
	-- shutdown ends the run or whether it goes on to relight the core, so a
	-- harness without it would be testing the other configuration and every
	-- full-flow scenario below would be asserting the wrong ending.
	ShutdownEndsShift = true,
	-- Also mirrors the shipped default, and it is the live one: the operator
	-- presses the shutdown lever himself, so the driver is handed no control.
	-- Scenarios that cover the retained press path opt in explicitly rather than
	-- this being flipped in a shared place, because a scenario that inherited the
	-- press by accident would assert an ending nobody shipped.
	DrivePressControls = false,
}

-- The recorder s readout table, as the driver sees it. Only `shut_down` reads it,
-- and it reads it to answer one question the driver cannot answer itself: did the
-- GAME agree that the shift is over? That is the replacement for the deleted
-- shutdown proof window, so a harness that left this out would leave the
-- replacement untested -- and, worse, would die on a nil index the first time any
-- scenario reached the state that uses it.
--
-- A scenario sets these from inside its own `tempOf`, which the simulator calls
-- once per step before handing the step to driveStep. That is the same order the
-- recorder uses -- readout first, driver second -- so the harness does not need a
-- second hook to model the world.
local last = {}

local pressed, pressedAt, nowT = {}, {}, 0
local function mk(id) return { __id = id, Parent = { GetFullName = function() return 'X.' .. id end } } end
local shutCandidates  = { mk('ShutClickPart'), mk('ShutFallback') }
local startCandidates = { mk('StartClickPart') }
local function pathOf(cd)
	if cd == nil then return 'nil' end
	return cd.Parent:GetFullName()
end
local function press(cd)
	-- One index, computed once. Writing `pressedAt[#pressed + 1]` after the line
	-- above is an off-by-one that leaves pressedAt[1] nil forever, so the first
	-- scenario dies on arithmetic with a nil the moment the core should respond
	-- to the first press -- which is the one press every scenario depends on.
	local n = #pressed + 1
	pressed[n] = cd.__id
	pressedAt[n] = nowT
