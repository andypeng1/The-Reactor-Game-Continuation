end
local drive = {
	on = true, state = 'arming', verdict = 'unsupported',
	holdT = 0, coldT = 0, armT = 0, proofT = 0,
	proofCd = nil, proofRunning = nil, waitingRun = false, waitingCold = false,
	shutIdx = 1, startIdx = 1, shutDone = false, shutSaid = '',
}
local sawDown, flowArmed = false, false
local now, t0 = 0, 0

local function driveStep(tempF, isRunning, dt)
	if not drive.on then return end
	if drive.state == 'inert' or drive.state == 'done' then return end

	-- dt is the caller s MEASUREMENT of the poll just finished, not the poll
	-- period this file configures. A configured constant is a claim about the
	-- loop; only the loop can report what the loop did. The 18:01 run is why that
	-- distinction is worth a parameter: the constant said 0.25 s, the loop ran at
	-- 3.38 Hz, and every dwell below came out 18 per cent long -- so the receipt
	-- said the core was switched off 60 s after the driver decided to, and the
	-- timestamps said 70.59.
	--
	-- Deliberately no upper clamp. If the client stalls for thirty seconds then
	-- thirty seconds passed, and the reactor spent them running; crediting thirty
	-- is the measurement, and clamping it would be a second assumption of exactly
	-- the kind this parameter removes. Only a value that cannot be a duration --
	-- absent, negative, or not a number at all -- falls back to the constant, so
	-- that a harness with no clock can still call this.
	if type(dt) ~= 'number' or dt ~= dt or dt <= 0 then
		dt = Config.SampleInterval
	end

	if drive.state == 'arming' then
		-- The core may already be lit when this is injected, or it may be cold.
		-- Arming is the wait that tells those two apart without a rule that can
		-- disagree with the game: flowArmed is the recorder s own confirmation
		-- that the core is running, and DriveArmSeconds of unbroken cold is the
		-- point at which it is not going to light itself.
		if flowArmed then
			-- WHERE THE CORE BEING UP LEADS DEPENDS ON WHO PRESSES. With the
			-- driver holding the controls, a running core means hold, then shut.
			-- With the operator holding them -- the live setting -- the same
			-- fact means the run has begun and the driver s job is to watch for
			-- his press. Splitting here rather than inside `holding` keeps every
			-- state readable as a statement about who acts next.
			if Config.DrivePressControls then
				drive.state = 'holding'
				drive.verdict = 'holding'
				emitEvt('DRIVE', 'armed, core already running; will switch it off in ' ..
					tostring(Config.DriveHoldSeconds) .. 's')
			else
				drive.state = 'watching'
				drive.verdict = 'watching'
				emitEvt('DRIVE', 'armed, core running; the driver presses nothing -- ' ..
					'press the shutdown lever when the shift should end')
				print('[rec] DRIVER: watching. Press the shutdown lever yourself;')
				print('[rec] DRIVER: the recorder will note the press and the reply.')
			end
			return
		end
		drive.armT = drive.armT + dt
		if drive.armT >= Config.DriveArmSeconds then
			if tempF == nil then
				-- Nothing to judge the core by, so nothing is pressed. Pressing
				-- blind on a live reactor is the one action here that cannot be
				-- undone, and "the readout is missing" is not "the core is off".
				drive.verdict = 'no-temp-readout'
				return
			end
			-- The timer has expired, but the core is READING AS RUNNING, so this
			-- is not the core the timeout is about. It is the debounce catching
			-- up: flowArmed needs DebounceSamples polls and this is still an
			-- early one. Wait for it rather than refusing.
			--
			-- This guard is what makes the measured dt safe. The first poll is
			-- the only one with no measured predecessor, and it is the one
			-- carrying the initial readout and lamp sweeps, so nothing bounds
			-- how long it takes. With dt measured, a first poll of twenty
			-- seconds or more would credit armT with twenty seconds in a single
			-- step and a driver injected on a perfectly healthy running core
			-- would report cold-at-inject and go inert -- on the run that has
			-- exactly one attempt. Under the old constant dt the debounce window
			-- was eighty polls wide and could not be crossed in one step.
			if isRunning then return end
			-- A COLD CORE IS NOT AN ERROR WHEN THE OPERATOR DRIVES, IT IS THE
			-- SCHEDULE. The recorder is injected before the shift begins and
			-- `A1` has the operator light the core himself, so a cold core at the
			-- end of the arm window is the expected opening rather than a state
			-- to act on. Nothing is pressed; the wait is announced once and the
			-- state machine stays in `arming`, which is the one state that goes on
			-- watching for `flowArmed`. The operator lighting the core is
			-- therefore not a special case -- it is the same edge that carries
			-- every other run into `watching`.
			if not Config.DrivePressControls then
				if not drive.waitingCold then
					drive.waitingCold = true
					emitEvt('DRIVE', 'core is cold after ' ..
						tostring(Config.DriveArmSeconds) .. 's tempF=' ..
						tostring(tempF) .. ' -- waiting for the operator to light it')
					print('[rec] DRIVER: the core is cold. Light it when you are ready;')
					print('[rec] DRIVER: nothing is pressed and nothing is spent.')
				end
				return
			end
			-- THE BUTTON IS THE AUTHORISATION, SO THE DRIVER LIGHTS IT.
			--
			-- This branch used to refuse, on the arithmetic that a flow needs one
			-- startup and one shutdown and that spending the startup on the
			-- opening leaves the end with none. The operator overruled that, and
			-- the reasoning is better than the arithmetic: pressing DRIVER is a
			-- person deciding that THIS attempt is the one to spend, and the
			-- driver declining to act on a decision it was handed is not caution
			-- -- it is the attempt spent on nothing.
			--
			-- What replaces the veto is a choice the driver can make from the
			-- plant instead of from an assumption. `arming` is the only state
			-- that does not know whether the core is up, and it answers that
			-- question by looking: running sends it to `holding` (switch it off),
			-- cold sends it here (switch it on). Neither mode needs the operator
			-- to declare which one he wanted, so neither can be declared wrong.
			emitEvt('DRIVE', 'armed cold after ' ..
				tostring(Config.DriveArmSeconds) .. 's tempF=' .. tostring(tempF) ..
				' -- lighting the core')
			print('[rec] DRIVER: the core is cold; lighting it.')
			print('[rec] DRIVER: one attempt, hands off the console.')
			drive.state = 'press_start'
			drive.verdict = 'arming-cold'
		end
		return
	end

	if drive.state == 'watching' then
		-- THE LIVE STATE. The core is up, the driver is holding no controls, and
		-- the only thing left to record is the operator s own shutdown and the
		-- game s answer to it.
		--
		-- The evidence is the same set of signals `shut_down` confirms from, read
		-- as a LEVEL rather than as an edge, because this is a report about the
		-- state of the world and not a trigger. The verdict doubles as the latch.
		--
		-- `v.shutdown` is first, and it is the one the operator named for the
		-- press itself (`B3`): pressing the shutdown lever puts
		-- `MonitorUI.ShutdownFrame` on screen. That is a screen appearing in the
		-- same second as the press, which is the closest thing to a direct read
		-- of the press that does not depend on a click line arriving. The end
		-- flags follow as fallbacks: a shift that ended some other way -- a cold
		-- trip, a machine-room meltdown -- is still a shift whose shutdown the
		-- driver should name rather than leave the file to explain.
		--
		-- No press is made here under any arm, including the flags. A machine
		-- that has ended the shift by itself is not one to hand a startup to --
		-- and with the driver unarmed that decision is not even reachable.
		if drive.verdict == 'watching' then
			local said
			if last['v.shutdown'] == true then
				said = 'the shutdown screen is up'
			elseif last['s.GameActive'] == false then
				said = 's.GameActive=false'
			elseif last['s.MainframeMeltdown'] == true then
				said = 's.MainframeMeltdown=true'
			elseif last['s.GameFail'] == true then
				said = 's.GameFail=true'
			end
			if said ~= nil then
				-- The wording follows the FLAG, because only the first flag is an
				-- operator action. The other three are the machine ending the
				-- shift by itself, and the comment above already says so -- but
				-- the sentence said `the operator shut it down` for all four, so
				-- it contradicted its own `said` field in the one line that
				-- records the seal. Seen 2026-09-26 in
				-- Data/flow/original_260926-230049: `the operator shut it down:
				-- s.MainframeMeltdown=true`, in a file with no shutdown-lever
				-- click anywhere -- 124 CLICK events, 0 of them on
				-- StartUpBigLever.ShutClickPart, and no v.shutdown either.
				--
				-- THE VERDICT IS LEFT ALONE. `user-shut` answers "who pressed",
				-- and "not the driver" is the honest answer for a meltdown too;
				-- renaming it would move the receipt field, the HOWTO table and
				-- four mutation proofs to say the same thing less precisely.
				local pressed = last['v.shutdown'] == true
				drive.shutDone = true
				drive.shutSaid = said
				drive.verdict = 'user-shut'
				emitEvt('DRIVE', (pressed and 'the operator shut it down: '
					or 'the shift ended: ') .. said .. ' tempF=' .. tostring(tempF))
				drive.state = 'shut_down'
			end
		end
		return
	end

	if drive.state == 'holding' then
		-- Real time before the switch-off, so the file contains steady state and
		-- not only two transients. It costs almost nothing: a steady reactor
		-- changes nothing, and nothing is what gets written.
		drive.holdT = drive.holdT + dt
		if drive.holdT >= Config.DriveHoldSeconds then drive.state = 'press_shut' end
		return
	end

	if drive.state == 'press_shut' then
		if tempF == nil then return end
		if not isRunning then
			-- Refuse. Pressing a shutdown switch on a core that is already down
			-- cannot be shown to have done anything, and the 18:01 run is the
			-- measured case: the hold expired at t=64, the core had crossed the
			-- threshold at t=65, and the press went out at t=73 on a reactor
			-- that was on its way back up. Wait for it to be running, then the
			-- press means what it says.
			if not drive.waitingRun then
				drive.waitingRun = true
				emitEvt('DRIVE', 'core is down before the shut press; waiting for a run')
			end
			return
		end
		drive.waitingRun = false
		-- Index 1 and only index 1. The list can hold more than one name for
		-- the same control, and the driver used to walk down it whenever a press
		-- proved inert. With one attempt there is no walking: the best evidenced
		-- candidate is pressed once, and a press that does nothing ends the run
		-- naming the control rather than spending a second attempt on a guess.
		local cd = shutCandidates[1]
		if cd == nil then
			drive.state = 'inert'
			drive.verdict = 'no-shut-control'
			emitEvt('DRIVE', 'no shutdown control found, nothing pressed')
			print('[rec] DRIVER: found no shutdown control. Nothing was pressed.')
			return
		end
		press(cd)
		-- The counters are the panel s, not the driver s: the panel prints
		-- `shut <shutIdx - 1>/<#candidates>`, so advancing it here is what makes
		-- the panel say one press was spent rather than none.
		drive.shutIdx = 2
		emitEvt('DRIVE', 'press shut ' .. pathOf(cd) .. ' tempF=' .. tostring(tempF) ..
			' running=' .. tostring(isRunning))
		-- THE PRESS IS THE SHUTDOWN, AND THE DRIVER BELIEVES IT IMMEDIATELY.
		--
		-- The operator is emphatic that pressing this lever shuts the core down
		-- at once and that there is no cold state to wait for. So there is no
		-- cooldown to watch and nothing to prove: this does not open a window, it
		-- declares the end in the same poll that it pressed.
		--
		-- What stood here was a forty-second window that accepted the press once
		-- the monitor temperature had fallen DriveProveF degrees below where it
		-- was at the press. On the 18:35 run that reported `shut accepted after
		-- 8.7s` at t=335.37, and the verdict was manufactured by its own
		-- threshold: m.fluct in that same file has p5 = -218 F, p95 = +253 F, and
		-- extremes past -1700 F, so a 431 F move in 8.7 s is inside the plant s
		-- ordinary wobble. The core had not gone down. s.GameActive stayed true
		-- for 414 seconds after the press, and the temperature ROSE from 10713 to
		-- 11838 in the thirty seconds that followed it. The proof did not measure
		-- a shutdown; it measured the noise and answered yes.
		--
		-- The price of believing the press is that an inert press is no longer
		-- named HERE. It is named by the thing that actually knows -- the game s
		-- own end-of-shift statement, watched in `shut_down` below. That is a
		-- stricter test than the old one rather than a looser one: a flag the game
		-- sets about itself cannot be satisfied by a sensor wobble.
		drive.shutDone = true
		drive.verdict = 'shut-accepted'
		if Config.ShutdownEndsShift then
			drive.state = 'shut_down'
		else
			drive.state = 'waiting_down'
		end
		return
	end

	if drive.state == 'shut_down' then
		-- A shutdown has already been declared -- by this driver s press, or by
		-- the operator s -- and it ended the shift. This state presses nothing and
		-- waits for nothing; it exists to WATCH, and only to watch.
		--
		-- The one thing worth having after the press is whether the game agreed
		-- with it. The 18:35 run is why. The driver pressed at t=326.71 and the
		-- plant showed no reaction for 414 seconds, so that file cannot say
		-- whether the shutdown lever works when an executor presses it -- which is
		-- the single most valuable thing the next run should answer. Recording
		-- the game s own statement separates "the press did not land" from "it
		-- landed and the shift runs on regardless", and it costs one line.
		--
		-- These are the same signals endReason trusts, and they are read as a
		-- LEVEL here rather than as an edge, because this is a report about the
		-- state of the world and not a trigger.
		--
		-- Two verdicts reach this state, and both mean "a shutdown was declared
		-- and nothing has been heard back about it yet": `shut-accepted` is this
		-- driver s own press, `user-shut` is the operator s. They are kept apart
		-- rather than collapsed into one, because they are the two answers to the
		-- question the run exists to ask -- does an executor s press land, and
		-- does the operator s -- and a file that merged them could not answer it.
		--
		-- SO `user-shut` IS NEVER OVERWRITTEN HERE, and that is a correction, not
		-- a preference. The first version of this block ran for both verdicts and
		-- set `shut-confirmed` on whatever it found -- which, for the operator s
		-- press, was the very signal that had just ended `watching`. The receipt
		-- therefore read `shut-confirmed` on a run where this driver never pressed
		-- anything, one poll after the file had said `user-shut`. The word means
		-- "the executor s press landed"; handing it to a press the executor did
		-- not make destroys the one distinction the live run exists to record.
		-- So the verdict is an answer to WHO PRESSED and only the press path
		-- changes it.
		--
		-- What the operator s run does still get is any signal that arrives AFTER
		-- the one that ended `watching` -- `v.shutdown` goes up with the press, and
		-- the game s formal `s.GameActive=false` can land 400 seconds later, and
		-- that second statement is news rather than an echo. `shutSaid` is what
		-- tells them apart: the signal already written down never fires again, and
		-- a different one always does. The two states search in different orders
		-- (see the field s own comment), so a later signal outranks its way to the
		-- front and the earlier one is found only when nothing else has come.
		local said
		if last['s.GameActive'] == false then
			said = 's.GameActive=false'
		elseif last['s.MainframeMeltdown'] == true then
			said = 's.MainframeMeltdown=true'
		elseif last['s.GameFail'] == true then
			said = 's.GameFail=true'
		elseif last['v.shutdown'] == true then
			said = 'the shutdown screen is up'
		end
		if said ~= nil and said ~= drive.shutSaid then
			drive.shutSaid = said
			if drive.verdict == 'shut-accepted' then
				drive.verdict = 'shut-confirmed'
			end
			emitEvt('DRIVE', 'the game confirms the shutdown: ' .. said ..
				' tempF=' .. tostring(tempF))
		end
		return
	end

	if drive.state == 'waiting_down' then
		-- REACHED ONLY WHEN A SHUTDOWN DOES NOT END THE SHIFT. The live
		-- configuration ends the run at the press itself -- press_shut goes
		-- straight to shut_down -- so what is left here is the other
		-- configuration s wait: the core has been told to stop, and the driver
		-- must not relight it until it actually has.
		--
		-- The gate is sawDown, the recorder s own DOWN edge, rather than a second
		-- opinion computed here. That is the point the whole PROVING section makes:
		-- a private temperature test is a second opinion about a plant the
		-- recorder is already reading, and when the two disagree there is nothing
		-- in the file that can settle which one was right.
		if sawDown and not isRunning then
			drive.coldT = 0
			drive.state = 'dwell_cold'
		end
		return
	end

	if drive.state == 'dwell_cold' then
		drive.coldT = drive.coldT + dt
		if drive.coldT >= Config.DriveColdSeconds then
			drive.state = 'press_start'
		end
		return
	end

	if drive.state == 'press_start' then
		if tempF == nil then return end
		if isRunning then
			drive.state = 'done'
			drive.verdict = 'relit-itself'
			emitEvt('DRIVE', 'core lit again without the driver')
			return
		end
		local cd = startCandidates[1]
		if cd == nil then
			drive.state = 'inert'
			drive.verdict = 'no-start-control'
			emitEvt('DRIVE', 'no startup control found, nothing pressed')
			print('[rec] DRIVER: found no startup control. Nothing was pressed.')
			return
		end
		drive.proofCd, drive.proofT = cd, 0
		drive.proofRunning = isRunning
		press(cd)
		drive.startIdx = 2   -- display only, for the same reason as shutIdx
		emitEvt('DRIVE', 'press start ' .. pathOf(cd) .. ' tempF=' .. tostring(tempF) ..
			' running=' .. tostring(isRunning))
		drive.state = 'proving_start'
		return
	end

	if drive.state == 'proving_start' then
		drive.proofT = drive.proofT + dt
		-- A START IS PROVED BY ARRIVAL, NOT BY A DELTA, for the same reason the
		-- shut is no longer proved at all. `rose` -- which accepted the press once
		-- the temperature had climbed DriveProveF degrees above where it stood at
		-- the press -- is gone with `fell`. They were the same test, and the same
		-- measurement disproved both.
		--
		-- The readout crossing the running threshold IS the state change, and it
		-- cannot be reached by wobble: the threshold sits thousands of degrees
		-- above a cold core, so nothing the noise does can fake this arrival.
		--
		-- press_start already returns early when the core is lit, so proofRunning
		-- is false here by construction; the field is read rather than assumed
		-- because "cannot currently be wrong" is a claim about today s code and
		-- not about the field.
		local nowUp = isRunning and drive.proofRunning == false
		if nowUp then
			emitEvt('DRIVE', 'start accepted after ' ..
				string.format('%.1f', drive.proofT) .. 's tempF=' .. tostring(tempF))
			drive.verdict = 'start-accepted'
			-- The core is up, so the driver goes back to `holding` and later
			-- switches it off. That makes the two ways in symmetric -- armed on
			-- a running core it shuts down, armed on a cold core it starts and
			-- THEN shuts down -- and both end in the same complete flow. It is
			-- also why `arming` does not have to be told which mode is wanted.
			--
			-- This branch was previously cut, on the argument that a startup
			-- opening the run left the end with no startup to spend and that a
			-- cold core was therefore refused. The refusal is gone (the operator
			-- made the button the authorisation), so the branch it was built
			-- against is reachable again and has to exist. `waiting_up` and its
			-- `flow-complete` verdict stay for the other configuration, where a
			-- shutdown does not end the shift and the recording is meant to
			-- close on the core coming back up.
			if Config.ShutdownEndsShift then
				drive.state = 'holding'
				drive.holdT = 0
			else
				drive.state = 'waiting_up'
			end
			return
		end
		if drive.proofT >= Config.DriveProveSeconds then
			emitEvt('DRIVE', 'start INERT ' .. pathOf(drive.proofCd) .. ' after ' ..
				tostring(Config.DriveProveSeconds) .. 's tempF=' .. tostring(tempF))
			print('[rec] DRIVER: ' .. pathOf(drive.proofCd) .. ' did nothing.')
			print('[rec] DRIVER: no second press. The core is down; seal when ready.')
			drive.state = 'inert'
			drive.verdict = 'start-inert'
		end
		return
	end

	if drive.state == 'waiting_up' then
		-- The recorder owns the rest: RUN -> DOWN -> UP, then it seals itself.
		if sawDown and isRunning then
			drive.state = 'done'
			drive.verdict = 'flow-complete'
			emitEvt('DRIVE', 'flow complete; the recorder will seal on its own')
		end
		return
	end
end

-- ========================== THE SIMULATED CORE ============================
-- A model of pollOnce s flow block, so the driver meets the same edges it will
-- meet in the game: a state has to hold three polls to count, and `sawDown`
-- latches. It is a MODEL -- the shipped detector already has three real
-- recordings behind it, and what is under test here is the driver s reaction to
-- those edges, not the edges themselves.
local DEB = 3
local lowRun, lowDown = 0, 0
local function flowStep(tempF)
	local isRunning = tempF ~= nil and tempF >= 5600
	if not flowArmed then
		if isRunning then
			lowRun = lowRun + 1
			if lowRun >= DEB then flowArmed = true end
		else
			lowRun = 0
		end
	elseif isRunning then
		lowDown = 0
	elseif not sawDown then
		lowDown = lowDown + 1
		if lowDown >= DEB then sawDown = true end
	end
	return isRunning
end

local function reset()
	pressed, pressedAt = {}, {}
	nowT = 0
	drive.on, drive.state, drive.verdict = true, 'arming', 'unsupported'
	drive.holdT, drive.coldT, drive.armT, drive.proofT = 0, 0, 0, 0
	drive.proofCd = nil
	drive.proofRunning, drive.waitingRun, drive.waitingCold = nil, false, false
	drive.shutIdx, drive.startIdx, drive.shutDone = 1, 1, false
	drive.shutSaid = ''
	sawDown, flowArmed = false, false
	lowRun, lowDown = 0, 0
	last = {}
	-- Reset to the LIVE setting, and the scenario re-applies its own choice
	-- afterwards. Done here rather than only in the Config literal above so that
	-- a scenario which opted into the press path cannot leak it into the next
	-- one -- the leak would be silent, and it would make the live scenarios pass
	-- for the wrong reason.
	Config.DrivePressControls = false
end

-- Runs `seconds` of simulated time in steps of `step` (default
-- Config.SampleInterval), and hands each step to driveStep AS the measured dt.
-- That is not a convenience: it is the contract. The shipped driver takes its
-- step from its caller, so a harness that advanced the clock by one amount while
-- telling the driver another would be testing a function nobody ships.
--
-- `step` is what makes S7 possible. A scenario with a one-second step simulates
-- a loop running four times slower than the configuration assumes, which is the
-- 18:01 situation in miniature.
--
-- `firstStep` is what makes S8 possible, and it models the one poll that has no
-- measured predecessor. The real first poll is the only one carrying the initial
-- readout and lamp sweeps, so it is the only one whose duration nothing bounds --
-- and with a measured dt that duration lands on the arm timer in a single step.
local function simulate(seconds, tempOf, step, firstStep)
	step = step or Config.SampleInterval
	local trace = {}
	local steps = math.floor(seconds / step + 0.5)
	for i = 1, steps do
		local thisStep = step
		if i == 1 and firstStep ~= nil then thisStep = firstStep end
		nowT = nowT + thisStep
		now = nowT
		local tempF = tempOf(nowT)
		local isRunning = flowStep(tempF)
		local before = drive.state
		driveStep(tempF, isRunning, thisStep)
		if drive.state ~= before then
			trace[#trace + 1] = string.format('%.2f  %s -> %s', nowT, before, drive.state)
		end
	end
	return trace
end

local function join(t)
	if #t == 0 then return '(none)' end
	return table.concat(t, '; ')
end

local function pressedList()
	if #pressed == 0 then return '(nothing pressed)' end
	return table.concat(pressed, ', ')
end

-- The clock at which press N happened, so a scenario s temperature can respond
-- to it. nil when that press has not happened yet.
local function sincePress(n)
	if pressedAt[n] == nil then return nil end
	return nowT - pressedAt[n]
end

-- `step` and `firstPress` are optional and exist for S7. `firstPress` is a
-- {lo, hi} window on the simulated time of the FIRST press, which is the only
-- assertion that can tell a driver which measures its step from one which
-- assumes it: the press happens either way, and only its timing differs.
local function scenario(name, seconds, tempOf, expectPresses, expectState, step, firstPress, firstStep, opts)
	reset()
	local firstResult = #results + 1
	-- The configuration this scenario runs under, applied AFTER reset (which
	-- restores the live default) and before the first step. Named rather than
	-- positional in the hope that a reader can tell at a glance which of the two
	-- answers to "who presses" a given scenario is asserting.
	opts = opts or {}
	Config.DrivePressControls = opts.pressControls == true
	local trace = simulate(seconds, tempOf, step, firstStep)
	local ok = true
	local notes = {}
	if pressedList() ~= expectPresses then
		ok = false
		notes[#notes + 1] = 'pressed [' .. pressedList() .. '] wanted [' .. expectPresses .. ']'
	end
	if drive.state ~= expectState then
		ok = false
		notes[#notes + 1] = 'state ' .. drive.state .. ' wanted ' .. expectState
	end
	-- The verdict and the confirmation count, both optional, both asked for only
	-- by the scenarios that need them. The verdict is how the two ways into
	-- `shut_down` stay told apart -- a state assertion cannot see the difference
	-- between a press this driver made and one the operator made, and that
	-- difference is the whole subject of the live run.
	if opts.verdict ~= nil and drive.verdict ~= opts.verdict then
		ok = false
		notes[#notes + 1] = 'verdict ' .. drive.verdict .. ' wanted ' .. opts.verdict
	end
	local confirms = nil
	if opts.confirms ~= nil then
		confirms = 0
		for i = firstResult, #results do
			if string.find(results[i], 'the game confirms', 1, true) ~= nil then
				confirms = confirms + 1
			end
		end
		if confirms ~= opts.confirms then
			ok = false
			notes[#notes + 1] = 'the confirmation was written ' .. confirms ..
				' times, wanted exactly ' .. tostring(opts.confirms)
		end
	end
	if firstPress ~= nil then
		local at = pressedAt[1]
		if at == nil then
			ok = false
			notes[#notes + 1] = 'no first press, wanted one at ' ..
				string.format('%.1f..%.1f', firstPress[1], firstPress[2])
		elseif at < firstPress[1] or at > firstPress[2] then
			ok = false
			notes[#notes + 1] = string.format(
				'first press at %.2f, wanted %.1f..%.1f -- a driver using the configured '
				.. 'poll period would press at %.1f', at,
				firstPress[1], firstPress[2],
				Config.DriveArmSeconds + Config.DriveHoldSeconds
					/ Config.SampleInterval * (step or Config.SampleInterval))
		end
	end
	say((ok and 'PASS ' or 'FAIL ') .. name)
	say('     pressed ' .. pressedList())
	say('     state   ' .. drive.state .. '  verdict ' .. drive.verdict)
	if confirms ~= nil then say('     confirms ' .. tostring(confirms)) end
	say('     trace   ' .. join(trace))
	if not ok then
		for _, n in ipairs(notes) do say('     !! ' .. n) end
	end
	say('')
end

-- ========================== S1 ============================================
-- Injected on a hot core, which is where the operator arms the driver: he
-- starts the core himself and presses DRIVER once it is up. The driver holds,
-- presses shut, and STOPS there -- in the same poll, without waiting to watch
-- the core come down. A shutdown ends the shift, so there is nothing left to
-- relight and nothing left to record; `shut_down` is a state with no press in
-- it, and the recorder s end-of-shift rule is what seals the file.
--
-- The falling temperature in this scenario is therefore decoration now: the
-- driver no longer reads it. It is left in place because a plant that stays hot
-- after a shutdown is a real case -- S2 is that case -- and because the two
-- scenarios together pin that the ending does not depend on the cooling.
scenario('S1 hot core, driver holds the controls', 300, function(t)
	local n = #pressed
	if n == 0 then return 22000 end
	local since = sincePress(n)
	return math.max(800, 22000 - since * 400)
end, 'ShutClickPart', 'shut_down', nil, nil, nil, { pressControls = true })

-- ========================== S2 ============================================
-- Injected on a hot core, and the temperature NEVER MOVES afterwards: the plant
-- ignores the switch completely.
--
-- This scenario used to assert `inert`. The driver was supposed to watch for the
-- temperature to fall, and to name the control when it did not. That assertion is
-- gone, and it is worth being exact about why it is not a loss of coverage.
--
-- The operator says the lever shuts the core down AT ONCE, so a fall in the
-- monitor temperature is not evidence about the press. The 18:35 run is the
-- measurement that settles it: that run s own `shut accepted after 8.7s` was
-- produced by a 431 F move, and m.fluct in the same file has p5 = -218 F and
-- p95 = +253 F with extremes past -1700. The move was inside the plant s
-- ordinary wobble, and the core had not gone down at all -- s.GameActive stayed
-- true for another 414 seconds and the temperature ROSE in the meantime.
--
-- What is asserted instead is the claim that was always the real one: exactly
-- ONE press, `ShutFallback` never touched, and the driver stops. A core that
-- ignores the switch cannot be told from one that obeys it at the moment of the
-- press -- so the driver does not try, and S9 is where the difference is named,
-- by the game s own statement rather than by a sensor.
scenario('S2 hot core, the plant ignores the press', 300, function() return 22000 end,
	'ShutClickPart', 'shut_down', nil, nil, nil, { pressControls = true })

-- ========================== S3 ============================================
-- Injected on a COLD core, which is how every shift now BEGINS.
--
-- THE OPERATOR REVERSED THIS ASSERTION, SO THE TEST MOVED WITH IT. It used to
-- require the driver to press nothing and report `cold-at-inject`, on the
-- argument that the one-shot rule reserved the startup for the end of the flow.
-- The answer is that the DRIVER BUTTON is the authorisation: pressing it is a
-- person deciding that this attempt is the one to spend, and a driver that then
-- declines to act has spent the attempt on nothing.
--
-- Written as a full-flow assertion rather than as "it presses StartClickPart",
-- because the interesting claim is not the first press but where the run ENDS.
-- A driver that lights the core and then sits in `waiting_up` forever, waiting
-- for a down-then-up that this configuration never performs, would pass the weak
-- version of this test.
--
-- The first press lands at the END of the arm window rather than before it: the
-- arm timer is what distinguishes "the core is cold" from "the readout has not
-- arrived yet", and S4 pins the other side of that.
scenario('S3 cold core is lit by the driver', 400, function(t)
	local n = #pressed
	if n == 0 then return 900 end
	local since = sincePress(n)
	if n == 1 then return math.min(22000, 900 + since * 2000) end
	return math.max(800, 22000 - since * 400)
end, 'StartClickPart, ShutClickPart', 'shut_down', nil, nil, nil, { pressControls = true })

-- ========================== S4 ============================================
-- No temperature readout at all. `isRunning` is false whenever the readout is
-- missing, exactly as it is when the core is off -- so this is the scenario
-- that catches a driver which reads a dead sensor as a dead reactor and starts
-- pressing switches on a plant it cannot see.
scenario('S4 no readout', 200, function() return nil end,
	'(nothing pressed)', 'arming')

-- ========================== S5 ============================================
-- The operator's own sequence, LIVE: the core is cold at inject, and the human
-- lights it BY HAND -- here a hundred seconds later, which is deliberately well
-- past the twenty-second arm window.
--
-- Lighting it INSIDE the window is the easy case and no longer the interesting
-- one. Past the window the driver has already decided the core was cold, and
-- that decision used to be the end of the matter: the old driver answered it by
-- pressing START, and under `D7` it is not allowed to. So what this asserts is
-- that the cold verdict is a REPORT and not a verdict -- nothing is pressed, the
-- state stays `arming`, and the operator's own startup carries it into
-- `watching` exactly as it would have if he had been quicker.
--
-- `waitingCold` is the latch that makes that wait say its piece once. A driver
-- that announced it every poll would pass every assertion here and still be
-- unusable, which is why the flag exists rather than the message being
-- unconditional.
scenario('S5 cold at inject, the operator lights it late', 400, function(t)
	return t < 120 and 900 or 22000
end, '(nothing pressed)', 'watching', nil, nil, nil, { verdict = 'watching' })

-- ========================== S6 ============================================
-- The 18:01 capture, reproduced. The core is running at inject, then goes down
-- ON ITS OWN before the hold expires, and comes back on its own later. The
-- driver must press NOTHING while it is down -- and must not credit itself with
-- the recovery. It presses once the core is running again, and only then.
--
-- Without the proofRunning gate this scenario fails in the specific way the
-- real run failed: the press goes out during the downtime and `not isRunning`
-- accepts it on the first poll, reporting a shutdown the driver did not cause.
scenario('S6 core dips on its own during the hold', 400, function(t)
	local n = #pressed
	if n == 0 then
		if t < 5 then return 22000 end
		if t < 80 then return 3000 end
		return 22000
	end
	local since = sincePress(n)
	return math.max(800, 22000 - since * 400)
end, 'ShutClickPart', 'shut_down', nil, nil, nil, { pressControls = true })

-- ========================== S7 ============================================
-- The 18:01 defect, reproduced. The loop runs at ONE SECOND per poll while the
-- configuration still says 0.25, which is what the real client did -- 283
-- samples over 83.78 s is 3.38 Hz against a configured four.
--
-- The assertion is not that the flow completes, because it completes either way.
-- It is WHEN the shut press lands. Measured, the hold expires 60 s after arming
-- and the press follows within a poll. Assumed, the driver counts 240 polls of
-- its own arithmetic and presses four times too late -- which is precisely the
-- 60-versus-70.59 gap the live run showed, blown up until it cannot be mistaken
-- for slack in the scenario.
scenario('S7 a slow loop is measured, not assumed', 400, function(t)
	local n = #pressed
	if n == 0 then return 22000 end
	local since = sincePress(n)
	return math.max(800, 22000 - since * 400)
end, 'ShutClickPart', 'shut_down', 1.0, { 55, 70 }, nil, { pressControls = true })

-- ========================== S8 ============================================
-- The first poll takes thirty seconds, and the core is running the whole time.
--
-- This is the one poll with no measured predecessor: it is the only one carrying
-- the initial readout discovery and lamp sweeps, so nothing bounds it, and with a
-- measured dt its whole duration lands on the arm timer in a SINGLE step. The
-- debounce needs three polls to confirm the core is running, so the arm window
-- can expire while the core reads perfectly healthy -- and the driver then
-- reports `cold-at-inject` and goes inert on a live reactor, on the one attempt
-- that was available.
--
-- The assertion is that it arms instead. It is worth more than S7 in one respect:
-- S7 catches a driver that under-counts time, which is a wrong number in a file.
-- S8 catches a driver that refuses to act, which is the attempt spent.
scenario('S8 a slow FIRST poll does not fake a cold core', 300, function(t)
	local n = #pressed
	-- The core has to RESPOND to the press, or the shut is inert for a reason
	-- that has nothing to do with the arm window and the scenario would be
	-- asserting on the wrong ending. First written without this, S8 failed with
	-- `shut-inert` -- which is the correct behaviour for a core that ignores the
	-- switch, and says nothing at all about the thing under test.
	if n == 0 then return 22000 end
	local since = sincePress(n)
	return math.max(800, 22000 - since * 400)
end, 'ShutClickPart', 'shut_down', nil, nil, 30, { pressControls = true })

-- ========================== S9 ============================================-- ========================== S9 ============================================
-- The operator presses, and the GAME then says the shift is over.
--
-- This is the live path end to end, and it is the scenario the whole `D7` change
-- was for. The driver presses nothing. It sits in `watching`, the operator s
-- press puts the shutdown screen up, and the driver names both the press and the
-- game s answer to it.
--
-- The evidence for the press is `v.shutdown`, which is the signal the operator
-- named for it (`B3`: pressing the shutdown lever shows
-- `MonitorUI.ShutdownFrame`). That is a screen appearing in the same second as
-- the press rather than an inference from the temperature, and it is the closest
-- thing to a direct read of the press that does not depend on a click line
-- arriving.
--
-- TWO SIGNALS ARRIVE, AND BOTH ARE WORTH A LINE: the shutdown screen goes up with
-- the press at t=100, and the game s own `s.GameActive` goes false at t=150. The
-- first ends `watching`; the second is the machine formally closing the shift,
-- which is the thing that arrives 414 seconds late in the 18:35 capture and is
-- therefore the single most valuable arrival in the whole run. So `confirms = 1`
-- counts the SECOND one -- and it is also the latch assertion, because a
-- confirmation that was not latched would be written on every poll after t=150
-- as well. That is the failure mode that makes a log useless rather than wrong,
-- and the one no state assertion can see.
--
-- THE VERDICT STAYS `user-shut`, and this is the assertion that pins it. The
-- first cut of the shipped code re-confirmed the operator s own press one poll
-- after `watching` ended and overwrote the verdict with `shut-confirmed` -- so
-- the receipt said "the executor s press landed" about a run in which the
-- executor never pressed. Every state assertion still passed; only the verdict
-- could see it.
--
-- `s.GameActive` is set from inside `tempOf`, which the simulator calls once per
-- step before handing the step to driveStep. That is the order the recorder reads
-- the world in, so the harness does not need a second hook to model it.
scenario('S9 the operator presses and the game confirms', 300, function(t)
	if t > 150 then last['s.GameActive'] = false end
	if t > 100 then last['v.shutdown'] = true end
	return 22000
end, '(nothing pressed)', 'shut_down', nil, nil, nil,
	{ verdict = 'user-shut', confirms = 1 })

-- ========================== S10 ===========================================
-- A hot core at inject and NOTHING EVER HAPPENS. Three hundred seconds of a
-- healthy reactor, no press by anyone, and the driver must still be sitting
-- there watching at the end of it.
--
-- This is the dullest scenario in the file and the most important one for the
-- live run, because the live driver s entire correctness is a negative: it must
-- not press. Every way that goes wrong -- arming on a running core and being
-- tempted to switch it off, getting bored during the arm window, treating the
-- absence of an end signal as permission to act -- ends in a press, and this is
-- the scenario that fails when one appears. The arm window expiring is
-- deliberate: the driver has watched the core run past the point where a cold
-- core would have been declared, and that must change nothing.
scenario('S10 hot core, no press from anyone', 300, function() return 22000 end,
	'(nothing pressed)', 'watching', nil, nil, nil, { verdict = 'watching' })

-- ========================== S11 ===========================================
-- The MACHINE ROOM melts down, and the driver names it as exactly that.
--
-- `D9`: `MainframeMeltdown` is the machine room, not the core, and this file used
-- to label it `meltdown (over 39000 F)`. The live driver reaches `shut_down` on
-- it like any other end of shift -- the machine room melting down IS the shift
-- ending from the operator s chair -- and the distinction survives in the message
-- the event carries, which is what a receipt is read for.
--
-- ONE SIGNAL, SO ONE LINE, AND NO CONFIRMATION. This flag is the only end signal
-- in the scenario, so it is the one that ends `watching` -- and `shut_down` then
-- finds the same flag and must recognise it as already written down rather than
-- reporting the machine s meltdown back to itself as a fresh confirmation. A
-- `confirms` of 0 is the assertion for that; it is the mirror image of S9, which
-- has a second signal to report. The two together are what pin that the guard is
-- "is this news" and not merely "is something set".
--
-- The temperature never moves. That is the point: this flag is not a temperature
-- rule, and a driver that inferred a core meltdown from it would be reading
-- 13000 F -- the value the flag actually fired at in the 18:35 capture -- as a
-- catastrophe.
scenario('S11 the machine room melts down', 300, function(t)
	if t > 60 then last['s.MainframeMeltdown'] = true end
	return 22000
end, '(nothing pressed)', 'shut_down', nil, nil, nil,
	{ verdict = 'user-shut', confirms = 0 })

-- Returned, not printed: this runs through an executor-tool boundary that shows
-- the chunk s return value and not necessarily its console, and a test whose
-- output nobody sees is a test nobody ran.
local report = table.concat(results, string.char(10))

-- And an exit code, so a caller can gate on it instead of reading the page. The
-- FAIL is what the scenario helper writes above; `io` and `os.exit` are absent in
-- Studio s Luau and present in the standalone interpreter, so this is guarded
-- rather than unconditional -- a harness that dies on its own failure path with
-- "attempt to index nil" reports the wrong reason for the right result.
if string.find(report, 'FAIL', 1, true) ~= nil and io ~= nil and io.stderr ~= nil then
	io.stderr:write(report .. string.char(10))
	os.exit(1)
end
return report
