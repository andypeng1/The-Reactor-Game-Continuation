--!nocheck
-- GENERATED by _tools/build_end_test.py -- edit that file, not this one.
--
-- `endReason` and the state it closes over are EXTRACTED from
-- _tools/TRG_original_recorder.luau. Everything else is mock; no Roblox API and
-- no DataModel instance is touched.

local results = {}
local function say(s) results[#results + 1] = tostring(s) end

local function check(name, got, want)
	local ok = (got == want)
	say((ok and 'PASS ' or 'FAIL ') .. name)
	if not ok then
		say('     got  [' .. tostring(got) .. ']')
		say('     want [' .. tostring(want) .. ']')
	end
end

local function checkTrue(name, cond, why)
	say((cond and 'PASS ' or 'FAIL ') .. name)
	if not cond then say('     ' .. why) end
end

-- The recorder's own numbers, EXTRACTED from it by extract_config() below.
-- They were typed here until the cold-trip line moved from 2000 F to 1000 F and
-- this copy did not: the dwell test then went on measuring a line the recorder
-- no longer had, and it would have kept passing. A copy of a configuration
-- proves nothing about that configuration, so there is no longer a copy.
local Config = {
	SampleInterval = 0.25,
	CoreThresholds = {5600, 17500, 29500, 39000},
	LowTripF = 1000,
	MeltdownF = 39000,
	SealColdSamples = 8,
	SealHotSamples = 8,
	SealDownSamples = 40,
	SealDeadSamples = 40,
}

-- A core that is cold ON PURPOSE, derived rather than typed so that a test about
-- the cold arm cannot outlive the number the cold arm uses.
local COLD_F = math.floor(Config.LowTripF / 2)

-- A core that is WARM BUT NOT RUNNING: above the cold-trip line and below the
-- run line at the same time. Two tests below need exactly that shape -- one to
-- keep the cold arm silent while the down counter is measured, one to keep it
-- silent while the counter is reset -- and both used to type a number that only
-- had that property by coincidence.
local WARM_F = math.floor((Config.LowTripF + Config.CoreThresholds[1]) / 2)

-- `last` is the recorder's carried-forward reading table: a key holds the last
-- value SEEN, not the value of this poll. The mock sets it directly, which is
-- exactly what put() does.
local last = {}
local sawDown = false

local everRan = false
local coldPolls, hotPolls, downPolls, deadPolls = 0, 0, 0, 0
local flagWas = {}
local function flagEdge(key, from, to)
	local v = last[key]
	if v == nil then return false end
	local was = flagWas[key]
	flagWas[key] = v
	if was == nil then return false end
	return was == from and v == to
end

local function endReason()
	local t = last['m.temp']
	if type(t) == 'number' and t >= Config.CoreThresholds[1] then everRan = true end

	if flagEdge('s.GameActive', true, false) then
		return 'shift over (GameActive true to false)'
	end
	if flagEdge('s.GameFail', false, true) then
		return 'shift failed (GameFail false to true)'
	end
	-- The machine room s meltdown, and it is named as that. The operator
	-- separated the two (`D9`: "MainframeMeltdown 是机房熔毁又不是核心熔毁"), and the
	-- separation is not pedantry -- the 18:35 run is the measurement. That flag
	-- went true at t=719.86 with the monitor reading about 13000 F, and the old
	-- label turned it into a 39000-degree core meltdown the file had never seen.
	-- A wrong cause in a receipt is worse than no cause: it is the one line a
	-- reader trusts when they are not going to re-derive the run.
	if flagEdge('s.MainframeMeltdown', false, true) then
		return 'machine room meltdown (MainframeMeltdown false to true)'
	end
	-- Nothing below this line can fire on a core that never ran, which is what
	-- keeps a cold opening from sealing itself.
	if not everRan then return nil end

	if type(t) == 'number' and t < Config.LowTripF then
		coldPolls = coldPolls + 1
		if coldPolls >= Config.SealColdSamples then
			return 'cold trip (under ' .. tostring(Config.LowTripF) .. ' F for ' ..
				tostring(coldPolls) .. ' polls)'
		end
	else
		coldPolls = 0
	end
	-- The core meltdown rule, and the only arm here that reads the hot end of
	-- the scale. `everRan` is above it and does not help this arm distinguish
	-- anything -- a core that never ran cannot read 39000 -- so the dwell is what
	-- keeps it honest: one bad readout is not a verdict.
	if type(t) == 'number' and t > Config.MeltdownF then
		hotPolls = hotPolls + 1
		if hotPolls >= Config.SealHotSamples then
			return 'core meltdown (over ' .. tostring(Config.MeltdownF) .. ' F for ' ..
				tostring(hotPolls) .. ' polls)'
		end
	else
		hotPolls = 0
	end
	-- The backstop may only count while the thing it is a backstop for is STILL
	-- TRUE, and "the core read as stopped" is a claim about the temperature, not
	-- about a key. `sawDown` is an EDGE -- it stays set from the DOWN until
	-- something clears it -- so a counter gated on the edge alone keeps counting
	-- through a recovery and then fires on a core that is demonstrably running.
	-- That is what sealed the 12:32 run: DOWN at t=549.73, back above the line at
	-- t=567.57, sealed 0.33 s after the recorder had itself emitted the UP, for
	-- "having been down 40 polls". Worse, it stole the ending from the settle
	-- path, so the receipt named the backstop instead of the relight -- a wrong
	-- cause, which is worse than no cause.
	--
	-- The reset uses the same expression `isRunning` uses, one line of arithmetic
	-- in one place. A monitor that reads `ERR F` (a string) resets nothing and
	-- counts nothing but stays down, which is the pre-existing behaviour for a
	-- blind monitor and is not what this change is about.
	if type(t) == 'number' and t >= Config.CoreThresholds[1] then
		-- Three cases, not a reset followed by the old two-way test: resetting
		-- and then falling through to the increment leaves the counter at 1 on
		-- a poll where the core is demonstrably RUNNING. That cannot fire the
		-- arm (1 is not 40), but it does make the dwell after a recovery one
		-- poll short, which is the sort of off-by-one that is only ever found by
		-- a harness -- and this one was.
		downPolls = 0
	elseif sawDown then
		downPolls = downPolls + 1
		if downPolls >= Config.SealDownSamples then
			return 'core read as down for ' .. tostring(downPolls) .. ' polls with no end signal'
		end
	else
		downPolls = 0
	end
	-- The only arm that does not need an edge, for a session that was already
	-- over when the script arrived and so can never produce one. `everRan` is
	-- still required, so it cannot fire on a cold start; a cold start that never
	-- lights up is sealed by the button, which is the one ending a human is
	-- always present for.
	if last['s.GameActive'] == false then
		deadPolls = deadPolls + 1
		if deadPolls >= Config.SealDeadSamples then
			return 'GameActive false for ' .. tostring(deadPolls) .. ' polls'
		end
	else
		deadPolls = 0
	end
	return nil
end

-- ---------------------------------------------------------------- helpers --
-- Every test starts from a plant that is running and healthy, then states only
-- the one thing it is about. A test that has to set up six fields to say one
-- thing is a test whose failure is ambiguous.
local function reset()
	last = {}
	last['s.GameActive'] = true
	last['s.GameFail'] = false
	last['s.MainframeMeltdown'] = false
	last['m.temp'] = 9000
	sawDown = false
	everRan = false
	coldPolls, hotPolls, downPolls, deadPolls = 0, 0, 0, 0
	flagWas = {}
end

-- Polls the rule n times and returns the reason it fired on, or nil if it never
-- did. Returned rather than asserted inside, so the COUNT that matters can be
-- asserted by the caller: "it eventually fires" and "it fires on the eighth
-- poll" are different claims and only the second one pins a dwell.
local function run(n)
	for i = 1, n do
		local r = endReason()
		if r ~= nil then return r, i end
	end
	return nil, n
end

-- ------------------------------------------------- E1 the 18:35 defect -----
-- GameActive true -> false. The whole point is the TIMING: the client is killed
-- during the wait that follows the poll that reported it, so this must fire on
-- the FIRST call after the edge and not after a dwell. A version of this rule
-- with a grace period would pass a test that only asked whether it fired at all.
reset()
check('E1 no seal while the shift is running', endReason(), nil)
last['s.GameActive'] = false
check('E1 true to false seals on the FIRST poll', run(1),
	'shift over (GameActive true to false)')

-- ------------------------------------------------- E2 the cold opening -----
-- THE ASSERTION THAT PROTECTS THE WHOLE NEW FLOW. A shift opens with the core
-- cold: COLD_F, below the cold-trip line and below the run line
-- (Config.CoreThresholds[1]) too -- so the recorder's own boundary has latched
-- `sawDown` as well. Both level tests are true simultaneously, in the state every
-- run now STARTS in, and this must stay silent indefinitely.
reset()
last['m.temp'] = COLD_F
sawDown = true
checkTrue('E2 a cold opening never seals itself', run(200) == nil,
	'a cold shift start sealed the file, so every run would die two seconds in')

-- And it is specifically `everRan` doing the work, not the absence of a signal:
-- the same cold readings AFTER the core has run must trip. If this passed only
-- because sawDown was false, E2 would be proving nothing.
reset()
last['m.temp'] = 9000
endReason()
last['m.temp'] = COLD_F
local _, at = run(Config.SealColdSamples + 5)
check('E2 the same reading trips once the core has run', at, Config.SealColdSamples)

-- ------------------------------------------------- E3 no readout -----------
-- A dead sensor is not a dead reactor, and it is not the end of a shift either.
-- Sealing on a missing temperature would end a recording on a mis-read, and the
-- temperature is the one key this rule cannot do without.
reset()
last['m.temp'] = nil
checkTrue('E3 a missing readout never seals', run(500) == nil,
	'a missing temperature sealed the file')

-- ------------------------------------------------- E4 the cold trip --------
-- The dwell, pinned at both ends: one poll short is not enough, and the poll the
-- configuration names is. The core is at COLD_F, under the cold-trip line and
-- over nothing else, so no other arm can fire and the count is unambiguous.
reset()
last['m.temp'] = 9000
endReason()
last['m.temp'] = COLD_F
check('E4 one poll short of the cold dwell', run(Config.SealColdSamples - 1), nil)
-- The expected reason is built from the same two fields the recorder builds it
-- from, so the number in the message cannot drift away from the number in the arm.
check('E4 the cold dwell fires on its own poll', run(1),
	'cold trip (under ' .. tostring(Config.LowTripF) .. ' F for ' ..
		tostring(Config.SealColdSamples) .. ' polls)')

-- A single dip must NOT accumulate: the counter is consecutive, or a core that
-- grazes the line eight times over an hour would seal on the eighth touch.
-- The fire is COUNTED rather than polled for at the end, because an accumulating
-- counter fires inside this loop -- and a version of this test that only looked
-- at the plant after the loop would find a healthy core, return nil, and pass
-- while the file had already been sealed mid-loop.
reset()
last['m.temp'] = 9000
endReason()
local grazed = false
for i = 1, 20 do
	last['m.temp'] = 1500
	if endReason() ~= nil then grazed = true end
	last['m.temp'] = 9000
	if endReason() ~= nil then grazed = true end
end
checkTrue('E4 the cold dwell counts consecutive polls', not grazed,
	'the cold counter accumulated across a recovered dip instead of resetting')

-- ------------------------------------------------- E5 the other flags ------
-- The priming `endReason()` is not ceremonial: flagEdge needs to have SEEN the
-- rest value before it can call a change a transition, so a plant that is
-- flipped before the first poll produces no edge by construction. Every scenario
-- here primes for the same reason -- and E5's negative case below depends on the
-- priming being ABSENT, which is what makes it a different test.
reset()
endReason()
last['s.GameFail'] = true
check('E5 GameFail false to true seals', run(1), 'shift failed (GameFail false to true)')
reset()
endReason()
last['s.MainframeMeltdown'] = true
-- NAMED AS THE MACHINE ROOM, AND THE TEMPERATURE IS DELIBERATELY NORMAL HERE.
-- The operator separated the two meltdowns (`D9`: 是机房熔毁又不是核心熔毁) after this
-- file had been labelling the flag `meltdown (over 39000 F)`. The 18:35 capture is
-- why the distinction is not pedantry: the flag went true at t=719.86 with the
-- monitor reading about 13000 F, so the old label reported a 39000-degree core
-- meltdown that had never happened. `m.temp` is set to a healthy value below for
-- the same reason -- with an absurd temperature in place, the core meltdown arm
-- could fire first and this assertion would pass for the wrong cause.
last['m.temp'] = 13000
check('E5 the machine room meltdown seals, named as the machine room',
	run(1), 'machine room meltdown (MainframeMeltdown false to true)')

-- ------------------------------------------------- E5b the core meltdown ---
-- The other half of the split, and the arm that had no reader at all until the
-- flag was taken away from it: `Config.MeltdownF` sat in the config with nothing
-- looking at it, because the machine-room flag had been standing in for the core
-- rule the operator gave (`A2`: over 39000 F and nothing else). Both directions
-- of the temperature scale now have an arm, and this is the hot one.
--
-- Counted rather than polled for, for the same reason as E4: the arm accumulates
-- a dwell, so a version of this test that only looked at the end state would pass
-- on a plant that had already sealed mid-loop.
reset()
last['m.temp'] = 9000
endReason()
last['m.temp'] = 40000
checkTrue('E5b the hot arm waits for its dwell', run(1) == nil,
	'the core meltdown arm fired on a single poll, before its dwell had run')

-- One poll short, then the poll that reaches the dwell. `run(n)` performs n
-- polls and returns the first non-nil reason, so the first call is the count-down
-- and the second is the firing poll -- and the pair pins that the arm counts
-- rather than firing on the last of them by luck.
reset()
last['m.temp'] = 9000
endReason()
-- The temperature has to be raised AFTER the priming poll, or the arm counts
-- nothing and the "one poll short" assertion below passes for the wrong reason:
-- it did exactly that on the first write of this test, reporting a silent arm
-- that was only ever reading a healthy core.
last['m.temp'] = 40000
local hotShort = run(7)
local hotFired = run(1)
checkTrue('E5b the hot arm is silent one poll short',
	hotShort == nil, 'the core meltdown arm fired with a poll still to count')
check('E5b the core meltdown seals over its line', hotFired,
	'core meltdown (over 39000 F for 8 polls)')

-- A flag that is ALREADY in its end state when the recorder arrives produces no
-- edge, and that is deliberate: the alternative is sealing at inject on a plant
-- nobody has looked at yet. It is caught by the deadPolls arm instead. No
-- priming here on purpose -- priming is exactly what would create the edge.
reset()
last['s.GameFail'] = true
checkTrue('E5 a level is not an edge', run(1) == nil,
	'a flag that was already set was read as a transition')

-- ------------------------------------------------- E6 already-dead session --
-- The only arm that does not need an edge, for a session that was over before
-- the script arrived. The temperature is above the cold-trip line, so the cold
-- arm cannot fire, and sawDown is false so the down arm cannot either -- which
-- leaves exactly one thing that can produce a reason here.
--
-- `flagWas` is cleared between setting the flag and polling, because that IS the
-- scenario: the flag was already false when the recorder started watching, so
-- there is no true->false transition to observe and the E1 arm cannot answer.
-- Without the clear this test would measure the edge instead, fire on its first
-- poll, and pass while testing nothing about the dead arm.
reset()
last['m.temp'] = 9000
endReason()
last['s.GameActive'] = false
flagWas = {}
local _, at2 = run(Config.SealDeadSamples + 5)
check('E6 a session that ended before inject still seals', at2, Config.SealDeadSamples)

-- And it is gated on the core having run, so it cannot fire on the cold opening
-- either. Without the gate, E2's plant plus a GameActive that reads false at
-- inject would seal ten seconds in.
reset()
last['m.temp'] = COLD_F
last['s.GameActive'] = false
checkTrue('E6 the dead arm is gated too', run(500) == nil,
	'an unstarted cold core sealed on GameActive alone')

-- ------------------------------------------------- E7 a missing key ---------
-- Absent, not false. A capture with no s.GameActive in it at all -- a different
-- place, a renamed folder, a Stats tree that has not spawned yet -- must not
-- read as "the shift is over", or the recorder seals itself on arrival.
reset()
last['s.GameActive'] = nil
checkTrue('E7 an absent flag is not a dead shift', run(500) == nil,
	'a nil read as false and sealed the file')

-- ------------------------------------------------- E8 precedence ------------
-- The reason is what a reader sees first, so when several arms are satisfiable
-- at once it must name the most definitive: the shift ended, not a cold trip
-- that happens to be true on the same poll. The 18:35 tail is exactly this
-- shape -- GameActive false arrived in the same poll as a temperature of 902,
-- and COLD_F is that shape by construction rather than by luck.
reset()
last['m.temp'] = 9000
endReason()
last['m.temp'] = COLD_F
sawDown = true
last['s.GameActive'] = false
check('E8 the shift ending outranks the cold trip', run(1),
	'shift over (GameActive true to false)')

-- ------------------------------------------------- E9 the down backstop -----
-- The arm that fired on a RECOVERED core in the 12:32 run, and until that run it
-- had NO test of its own: `SealDownSamples` appeared exactly once in this file --
-- in the Config table above -- and nothing here ever made it fire. A guard that
-- has never gone off is indistinguishable from one wired to nothing, which is
-- how a backstop becomes the thing that truncates a live recording.
--
-- The temperature here is BELOW CoreThresholds[1] on purpose, and that is the
-- whole trick of the new rule: the arm now resets its counter while the core
-- reads as running, so the obvious test -- 9000 F with sawDown set -- would find
-- itself measuring the RESET rather than the count, and would pass against a
-- backstop that can no longer fire at all. WARM_F is above the trip line, so the
-- cold arm cannot answer, and below the run line, so the counter is left alone.
reset()
last['m.temp'] = 9000
endReason()
last['m.temp'] = WARM_F
sawDown = true
local _, downAt = run(Config.SealDownSamples + 5)
check('E9 a core down with no end signal still seals', downAt, Config.SealDownSamples)

-- The wording is part of the fix and not decoration. The old string was "held
-- down 40 polls with no end signal", and the operator read it the natural way --
-- as a key being held down -- which is wrong: `sawDown` is an edge over the
-- core's own temperature reading. A receipt's reason line is the one line a
-- reader trusts when they are not going to re-derive the run, so it has to name
-- what was actually measured.
reset()
last['m.temp'] = 9000
endReason()
last['m.temp'] = WARM_F
sawDown = true
check('E9 the reason names the core, not a key',
	select(1, run(Config.SealDownSamples)),
	'core read as down for ' .. tostring(Config.SealDownSamples) ..
	' polls with no end signal')

-- E9 b THE 12:32 DEFECT, IN FOUR LINES. Count the backstop almost to its dwell,
-- let the core read as running for ONE poll, then go quiet again. The count must
-- restart, or the file is sealed by a dwell that was accumulated across a
-- recovery -- and the old rule tested only the `sawDown` EDGE, which nothing had
-- cleared, so it counted straight through the recovery and fired 0.33 s after the
-- recorder had itself emitted the UP, on a core that was back at 5810 F.
--
-- `sawDown` is deliberately LEFT TRUE, i.e. the edge is not cleared as the flow
-- rule now clears it. The reset has to hold on its own: the two rules live in
-- different regions of the recorder, and the order they run in within a single
-- poll is not something this arm should depend on.
reset()
last['m.temp'] = 9000
endReason()
last['m.temp'] = WARM_F
sawDown = true
run(Config.SealDownSamples - 4)
last['m.temp'] = 9000
checkTrue('E9 b one running poll resets the countdown', endReason() == nil,
	'the up poll itself fired the backstop')
last['m.temp'] = WARM_F
local leaked = run(Config.SealDownSamples - 1)
checkTrue('E9 b the countdown restarts from the recovery', leaked == nil,
	'the counter carried across a recovery, so the dwell was reached early')
check('E9 b and it fires on its own poll afterwards', select(1, run(1)),
	'core read as down for ' .. tostring(Config.SealDownSamples) ..
	' polls with no end signal')

-- E9 c a monitor reading `ERR F` while the core is down must not disable the
-- backstop. `ERR F` is a STRING, so the reset cannot mistake it for a running
-- core. Treating an unreadable temperature as "possibly running" would mean a
-- sensor that dies with the core leaves the file unsealed forever -- which is
-- the 18:35 failure, arrived at from the other side.
reset()
last['m.temp'] = 9000
endReason()
last['m.temp'] = 'ERR F'
sawDown = true
local _, blindAt = run(Config.SealDownSamples + 5)
check('E9 c an unreadable monitor does not stop the backstop', blindAt,
	Config.SealDownSamples)

-- ------------------------------------------------------ report + exit ------
local report = table.concat(results, string.char(10))

if string.find(report, 'FAIL', 1, true) ~= nil and io ~= nil and io.stderr ~= nil then
	io.stderr:write(report .. string.char(10))
	os.exit(1)
end
return report
