announceClock()
check('K1 the inject read is a state, not an arrival', emitted[1],
	'CLOCK|the clock already reads past 12:00PM at inject; the core is up')

last['q.up'], last['q.timeText'] = false, '12:00 PM'
announceClock()
last['q.up'], last['q.timeText'] = true, '12:01 PM'
announceClock()

check('K1 three events in total', #emitted, 3)
checkTrue('K1 no shift start is announced after a mid-shift inject',
	string.find(table.concat(emitted, ' '), 'shift has started') == nil,
	'an in-game day wrap was announced as the start of a shift')
checkTrue('K1 both wrap events name themselves a dial move',
	string.find(emitted[2], 'the dial') ~= nil and
	string.find(emitted[3], 'the dial') ~= nil,
	'the wrap cannot be told from a shift boundary by a reader of the file')

