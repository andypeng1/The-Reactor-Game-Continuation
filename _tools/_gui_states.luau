--!nocheck
-- GENERATED by _tools/build_gui_test.py -- edit that file, not this one.
--
-- The two player-GUI regions and `keyForLabel` are EXTRACTED from
-- _tools/TRG_original_recorder.luau and run against a mock PlayerGui tree.
-- No Roblox API is touched.

local results = {}
local function say(s) results[#results + 1] = tostring(s) end

local function check(name, got, want)
	local ok = (got == want)
	say((ok and 'PASS ' or 'FAIL ') .. name)
	if not ok then
		say('     got  [' .. tostring(got) .. ']')
		say('     want [' .. tostring(want) .. ']')
	end
end

local function checkTrue(name, cond, why)
	say((cond and 'PASS ' or 'FAIL ') .. name)
	if not cond then say('     ' .. tostring(why or 'no reason given')) end
end

-- ========================== MOCK ENGINE ===================================
-- The class map is the one measured in Studio, including the part that matters
-- most: which of the two flags a class REFUSES to answer.
local ISA = {
	ScreenGui    = { ScreenGui = true, LayerCollector = true, GuiBase2d = true },
	SurfaceGui   = { SurfaceGui = true, LayerCollector = true, GuiBase2d = true },
	Frame        = { Frame = true, GuiObject = true, GuiBase2d = true },
	TextLabel    = { TextLabel = true, GuiObject = true, GuiBase2d = true },
	TextButton   = { TextButton = true, GuiObject = true, GuiBase2d = true },
	TextBox      = { TextBox = true, GuiObject = true, GuiBase2d = true },
	ImageLabel   = { ImageLabel = true, GuiObject = true, GuiBase2d = true },
	-- Neither flag, and it still claims to be a GuiObject. This is the class that
	-- the class-name test would have got wrong and the probe gets right.
	BizarreGui   = { BizarreGui = true, GuiObject = true, GuiBase2d = true },
	Folder       = { Folder = true },
	UIListLayout = { UIListLayout = true },
}

local function isa(class, want)
	local t = ISA[class]
	if t ~= nil and t[want] == true then return true end
	return class == want
end

local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({ _fns = {} }, Signal) end
function Signal:Connect(f) self._fns[#self._fns + 1] = f end
function Signal:Fire(...)
	for i = 1, #self._fns do self._fns[i](...) end
end

local Inst = {}

-- How many property reads the mock was actually asked for.  The
-- reader runs four times a second, so its price is a property of the
-- shipped design and not a matter of taste -- and it is COUNTED here
-- rather than timed, because a timing taken on a mock measures the mock.
FLAG_READS = 0

local function err(what, class)
	error(what .. ' is not a valid member of ' .. class, 2)
end

Inst.__index = function(self, k)
	local raw = rawget(self, k)
	if raw ~= nil then return raw end
	if k == 'Visible' then
		FLAG_READS = FLAG_READS + 1
		if isa(self.ClassName, 'LayerCollector') or self.ClassName == 'BizarreGui' then
			err('Visible', self.ClassName)
		end
		return self._visible
	elseif k == 'Enabled' then
		FLAG_READS = FLAG_READS + 1
		if not isa(self.ClassName, 'LayerCollector') or self.ClassName == 'BizarreGui' then
			err('Enabled', self.ClassName)
		end
		return self._enabled
	elseif k == 'DescendantAdded' or k == 'DescendantRemoving' then
		local s = Signal.new()
		rawset(self, k, s)
		return s
	end
	return Inst[k]
end

local function new(class, name)
	return setmetatable({
		ClassName = class, Name = name,
		_kids = {}, _visible = true, _enabled = true,
	}, Inst)
end

function Inst:IsA(c) return isa(self.ClassName, c) end

function Inst:GetChildren()
	local t = {}
	for i = 1, #self._kids do t[i] = self._kids[i] end
	return t
end

function Inst:GetDescendants()
	local t = {}
	local function walk(n)
		for i = 1, #n._kids do
			t[#t + 1] = n._kids[i]
			walk(n._kids[i])
		end
	end
	walk(self)
	return t
end

function Inst:GetFullName()
	local parts, n = {}, self
	while n ~= nil do
		table.insert(parts, 1, n.Name)
		n = n.Parent
	end
	return table.concat(parts, '.')
end

function Inst:FindFirstChild(n)
	for i = 1, #self._kids do
		if self._kids[i].Name == n then return self._kids[i] end
	end
	return nil
end

function Inst:IsDescendantOf(o)
	local n = self.Parent
	while n ~= nil do
		if n == o then return true end
		n = n.Parent
	end
	return false
end

-- Adding a child fires the parent chain's DescendantAdded, which is what the
-- shipped reader listens to. Firing it is the only way to test that it does.
local function add(parent, child)
	child.Parent = parent
	parent._kids[#parent._kids + 1] = child
	local n = parent
	while n ~= nil do
		local s = rawget(n, 'DescendantAdded')
		if s ~= nil then s:Fire(child) end
		n = n.Parent
	end
	return child
end

local function remove(parent, child)
	for i = 1, #parent._kids do
		if parent._kids[i] == child then table.remove(parent._kids, i) break end
	end
	child.Parent = nil
	local n = parent
	while n ~= nil do
		local s = rawget(n, 'DescendantRemoving')
		if s ~= nil then s:Fire(child) end
		n = n.Parent
	end
	return child
end

-- ========================== MOCK RECORDER SURFACE =========================
local Config = { MaxGuiObjects = 3, MaxGuiLabels = 2 }

local Players = {}
local buoy = {}
local putCalls, evts = {}, {}
local lastPut = {}

local function put(key, value)
	putCalls[#putCalls + 1] = { key = key, value = value }
	lastPut[key] = value
end

local function emitEvt(kind, rest)
	evts[#evts + 1] = tostring(kind) .. ' ' .. tostring(rest)
end

local function putsWithKey(k)
	local t = {}
	for i = 1, #putCalls do
		if putCalls[i].key == k then t[#t + 1] = putCalls[i] end
	end
	return t
end

local function keysOffered()
	local t = {}
	for i = 1, #putCalls do t[#t + 1] = putCalls[i].key end
	return t
end

local function evtOf(kind)
	for i = 1, #evts do
		if string.sub(evts[i], 1, #kind + 1) == (kind .. ' ') then return evts[i] end
	end
	return nil
end

local function reset()
	putCalls, evts, lastPut = {}, {}, {}
end

-- `readoutDirty` is a real local in the recorder and a plain global here,
-- because the readout walk it belongs to is not extracted. What matters is that
-- a rebuild SETS it -- a player's label added mid-shift has to reach the sweep
-- that reads captions, or the screen is recorded for its flags and never for
-- its text.
readoutDirty = false

-- ==================== PLAYER GUI: STATE ==================================
-- The player's own screen. It is CLIENT-ONLY -- PlayerGui does not exist on the
-- server and nothing about it replicates -- so a script injected into the client
-- is the only thing in the world that can see it at all, which is why this is
-- the recorder's job and not the room watcher's.
--
-- The state is declared HERE, above its first use, because the readout walk
-- below reaches into PlayerGui to pick up the player's labels. Only functions
-- have to be in scope above their definition; a `local` just has to exist, and
-- this file has lost a night to the difference. `isOwnGui` is the one forward
-- declaration, because it is a function and it is used above where it belongs.
local guiRecords, guiDirty = {}, true
local guiCount, guiOver, guiUnreadable = 0, 0, 0
local guiLabels, guiLabelOver = 0, 0
local guiRoot, guiHooked = nil, false
local guiMapped = {}
local isOwnGui


local function keyForLabel(label, seen)
	-- Try the shortest suffix of the ancestry that is unique: parent.Name alone
	-- first, then grandparent, and so on. Two consoles can both own a TempLabel
	-- and dropping one of them silently would be the exact failure this block
	-- exists to prevent, so the walk deepens until the key is free.
	for depth = 2, 7 do
		local node, parts = label, {}
		for _ = 1, depth do
			if node == nil then break end
			table.insert(parts, 1, node.Name)
			node = node.Parent
		end
		local k = table.concat(parts, '.')
		if not seen[k] then return k end
	end
	return label:GetFullName()
end

-- ========================== PLAYER GUI ====================================
-- What the game tells the PLAYER, which is not the same thing as what it tells
-- the wall. Every reader above this line is pointed at a world object -- a
-- monitor bolted to a wall, a labelled console. This one is pointed at
-- PlayerGui: the screen the operator is actually looking at, which is
-- CLIENT-ONLY and does not replicate, so nothing but a script running inside the
-- client can see it at all.
--
-- Two different things are collected from PlayerGui and they are deliberately
-- kept in two different namespaces, because one writer per fact is the rule:
--
--   g.<key>   the object's own flag -- Visible on a GuiObject, Enabled on a
--             ScreenGui. Read once per object per poll, changed-filtered, so a
--             screen that just sits there costs nothing after its first poll.
--   t./x.<key> the caption, and those labels are handed to the readout walk
--             above instead of being read here, because the readout walk already
--             has the chatter guard, the TMAP manifest and the ANIM/NOISY
--             verdicts, and a second copy of that machinery would be a second
--             opinion about the same string.
--
-- `g.<key>` is the object's OWN flag and is NOT a claim about what the player can
-- see. A Visible=true label inside a Visible=false Frame, or inside a ScreenGui
-- whose Enabled is false, is recorded as true and is not on screen. That gap is
-- deliberate, and it is the whole argument for this design: the honest flag
-- costs one ancestor read per object per poll, which at four polls a second is a
-- bigger bill than every world readout in this file put together -- and the
-- operator is already paying the bill for the world. What closes most of the gap
-- for free is the ScreenGui's own Enabled, which is read here: a screen that is
-- off is one line, and everything under it is off with it.
local function readVisible(o) return o.Visible end
local function readEnabled(o) return o.Enabled end

-- Which of the two a given object answers to is PROBED, not decided from its
-- class name. Measured in Studio on 2026-09-27: LayerCollector (ScreenGui,
-- SurfaceGui, BillboardGui, GuiMain) has Enabled and THROWS on Visible, while
-- GuiObject (Frame, TextLabel, ..., CanvasGroup, ScrollingFrame) has Visible and
-- THROWS on Enabled -- no class has both, and asking for the wrong one is not a
-- nil, it is an error. An `IsA('LayerCollector') and ... or ...` test would be
-- correct today and silently wrong the day a class is added, and the cost of
-- being wrong is not one bad line: readGui throws, the whole poll throws, and
-- the run records nothing at all. So the object is asked once per rebuild --
-- never per poll, which is why this can afford a pcall -- and anything that
-- answers neither is dropped and counted rather than guessed at.
local function flagReaderFor(d)
	if pcall(readVisible, d) then return readVisible end
	if pcall(readEnabled, d) then return readEnabled end
	return nil
end

-- The recorder's own panel is parented to PlayerGui and rewrites its text four
-- times a second by construction. Recording it would be recording the recorder:
-- the readout guard would eventually condemn it as NOISY, so the file would
-- carry a complaint about a label this very script owns. Excluded by ANCESTRY
-- rather than by name, so renaming the panel cannot put it back in. This is the
-- definition of the forward declaration made above the readout walk.
function isOwnGui(inst)
	local g = buoy.gui
	if g == nil then return false end
	return inst == g or inst:IsDescendantOf(g)
end

local function ensureGuiRoot()
	if guiRoot ~= nil then return true end
	local player = Players.LocalPlayer
	if player == nil then return false end
	local pg = player:FindFirstChild('PlayerGui')
	if pg == nil then return false end
	guiRoot = pg
	if not guiHooked then
		guiHooked = true
		-- Structure is event-driven, values are polled -- the same split the lamp
		-- matrix and the readout list already use. A screen the game creates
		-- halfway through the shift is then picked up on the poll after it
		-- appears rather than at the next periodic rescan a minute later.
		pcall(function()
			pg.DescendantAdded:Connect(function() guiDirty = true end)
			pg.DescendantRemoving:Connect(function() guiDirty = true end)
		end)
	end
	return true
end

local function buildGui()
	if not ensureGuiRoot() then return end
	local seen = {}
	local out, n, over, unreadable = {}, 0, 0, 0
	for _, d in ipairs(guiRoot:GetDescendants()) do
		local isLayer = d:IsA('LayerCollector')
		if (isLayer or d:IsA('GuiObject')) and not isOwnGui(d) then
			local reader = flagReaderFor(d)
			if reader == nil then
				unreadable = unreadable + 1
			elseif n >= Config.MaxGuiObjects then
				over = over + 1
			else
				n = n + 1
				local k = keyForLabel(d, seen)
				seen[k] = true
				out[#out + 1] = { inst = d, key = 'g.' .. k, read = reader }
			end
		end
	end
	guiRecords, guiCount, guiOver, guiUnreadable = out, n, over, unreadable
	-- One manifest line per object, once. A `g.` key in a change line with no
	-- GMAP anywhere in the file is a boolean nobody can attribute, which is the
	-- same reason TMAP and LAMPMAP exist.
	for _, rec in ipairs(out) do
		if not guiMapped[rec.key] then
			guiMapped[rec.key] = true
			emitEvt('GMAP', rec.key .. ' ' .. rec.inst.ClassName ..
				' ' .. rec.inst:GetFullName())
		end
	end
	-- The count is reported even when the cap was not reached, and the overflow
	-- separately, because "600 objects" and "at least 600 objects" are different
	-- findings and only one of them means the recording is incomplete.
	emitEvt('GUI', 'objects=' .. tostring(n) ..
		' over=' .. tostring(over) ..
		' unreadable=' .. tostring(unreadable) ..
		' labels=' .. tostring(guiLabels) ..
		' label_over=' .. tostring(guiLabelOver))
	-- The readout list is built by a different pass and holds its own copy of the
	-- player's labels, so a rebuild here has to invalidate that list too or a
	-- screen created mid-shift is never read for text.
	readoutDirty = true
	guiDirty = false
end

local function readGui()
	if guiDirty then buildGui() end
	for i = 1, #guiRecords do
		local rec = guiRecords[i]
		put(rec.key, rec.read(rec.inst))
	end
	put('g.objects', guiCount)
	put('g.over', guiOver)
	put('g.unreadable', guiUnreadable)
	put('g.labels', guiLabels)
	put('g.labelOver', guiLabelOver)
end



-- ========================== THE TREE ======================================
-- One player, one PlayerGui, and the recorder's own panel inside it -- because
-- that is where buildUi puts it, and a harness that left it out would be
-- handing the reader an easier tree than the one it ships against.
local player = new('Player', 'tester')
local pg = add(player, new('PlayerGui', 'PlayerGui'))
Players.LocalPlayer = player

-- The recorder's panel: a ScreenGui with a Frame and a TextLabel under it.
local own = add(pg, new('ScreenGui', 'TRGRecorder'))
local ownPanel = add(own, new('Frame', 'panel'))
local ownText = add(ownPanel, new('TextLabel', 'text'))
buoy.gui = own

-- The game's screens.
local hud = add(pg, new('ScreenGui', 'Hud'))
local hudFrame = add(hud, new('Frame', 'HudFrame'))
local hudLabel = add(hudFrame, new('TextLabel', 'TempLabel'))
local hudBtn = add(hudFrame, new('TextButton', 'PowerButton'))

local menu = add(pg, new('ScreenGui', 'Menu'))
local menuFrame = add(menu, new('Frame', 'MenuFrame'))
local menuLabel = add(menuFrame, new('TextLabel', 'TempLabel'))

-- Neither flag, and it claims to be a GuiObject.
local odd = add(pg, new('BizarreGui', 'OddOne'))
-- Not a GuiObject and not a LayerCollector: skipped before it is ever asked.
local layout = add(hudFrame, new('UIListLayout', 'Layout'))

-- The keys are NOT written down here. keyForLabel deepens a key until it is
-- free, starting at depth 2, so the third screen in the tree gets a different
-- key from the first, and spelling one out would make this file assert its own
-- guess about the naming rule instead of the rule. Every check below asks the
-- reader what it called the object.
local function keyOf(inst)
	for i = 1, #guiRecords do
		if guiRecords[i].inst == inst then return guiRecords[i].key end
	end
	return nil
end

local function seen(inst)
	local k = keyOf(inst)
	if k == nil then return nil end
	return lastPut[k]
end

-- The cap is raised for the behavioural checks so that every object under test
-- is inside it, and lowered only for the check that is about the cap.
Config.MaxGuiObjects = 99
reset()
buildGui()

-- ========================== G1 THE FLAGS ==================================
-- The screen answers Enabled and the frame answers Visible. Both are read, and
-- the arm a class-name test would have picked for the ScreenGui is the one that
-- raises -- so a reader that chose by class name cannot pass G1.
reset()
readGui()
check('G1 the HUD screen is a record', keyOf(hud) ~= nil, true)
check('G1 the frame under it is a record', keyOf(hudFrame) ~= nil, true)
check('G1 the layout is not a record', keyOf(layout), nil)
check('G1 the screen reads its Enabled', seen(hud), true)
check('G1 the frame reads its Visible', seen(hudFrame), true)

hud._enabled = false
reset()
readGui()
check('G1 a disabled screen reads false', seen(hud), false)
check('G1 the frame is unaffected by the screen', seen(hudFrame), true)

hud._enabled = true
hudFrame._visible = false
reset()
readGui()
check('G1 an invisible frame reads false', seen(hudFrame), false)
check('G1 the screen is unaffected by the frame', seen(hud), true)
hudFrame._visible = true

-- ========================== G2 THE PROBE ==================================
-- BizarreGui claims GuiObject and answers NEITHER flag. A class-name test picks
-- Visible for it, raises on the very first poll, and takes the whole poll with
-- it -- which is the whole run, since readGui sits inside the poll's pcall.
--
-- The rebuild is forced: the GUI event under test is emitted by buildGui, and a
-- poll that finds the tree clean never emits one -- so a test that read the tree
-- without dirtying it would be asserting over an empty event list and calling
-- the absence a pass.
reset()
buildGui()
readGui()
checkTrue('G2 a class that answers neither flag is not a record',
	keyOf(odd) == nil, 'it was registered anyway')
checkTrue('G2 and readGui did not raise over it',
	(select(1, pcall(readGui)) == true), 'readGui raised on the unreadable class')
local guiEvt = evtOf('GUI')
checkTrue('G2 the GUI event names the unreadable count', guiEvt ~= nil
	and string.find(guiEvt, 'unreadable=1', 1, true) ~= nil, tostring(guiEvt))

-- ========================== G3 THE RECORDER'S OWN PANEL ===================
check('G3 the panel is not a record', keyOf(ownPanel), nil)
check('G3 the panel text label is not a record', keyOf(ownText), nil)
check('G3 the panel screen is not a record', keyOf(own), nil)

-- Renaming it cannot put it back: the exclusion is by ancestry, not by name.
own.Name = 'SomethingElse'
reset()
buildGui()
readGui()
check('G3 renamed, the panel is still not a record', keyOf(ownPanel), nil)
check('G3 renamed, its label is still not a record', keyOf(ownText), nil)
own.Name = 'TRGRecorder'

-- ========================== G4 EXCLUSION IS NOT BY LUCK ===================
-- A Frame that is NOT under the panel, with a child whose name collides with the
-- panel's own child name. Both must be recorded, or the exclusion is a name test
-- wearing an ancestry costume.
local free = add(hudFrame, new('Frame', 'freePanel'))
local freeText = add(free, new('TextLabel', 'text'))
reset()
buildGui()
readGui()
checkTrue('G4 a frame outside the panel IS recorded',
	keyOf(free) ~= nil, 'it was excluded along with the panel')
checkTrue('G4 and its child is recorded even though the name collides',
	keyOf(freeText) ~= nil, 'the exclusion leaked past the panel')
remove(hudFrame, free)

-- ========================== G5 THE KEY IS UNIQUE ==========================
-- Two TempLabels, one per screen. A key built from the name alone collapses them
-- into one record holding its own dedup state, and one of the two then stops
-- reporting changes -- silently, which is exactly why keyForLabel deepens.
reset()
buildGui()
readGui()
local kh, km = keyOf(hudLabel), keyOf(menuLabel)
checkTrue('G5 two same-named labels get two keys',
	kh ~= nil and km ~= nil and kh ~= km,
	tostring(kh) .. ' vs ' .. tostring(km))
checkTrue('G5 and both were offered',
	seen(hudLabel) ~= nil and seen(menuLabel) ~= nil,
	'one of the two never reached put')

-- ========================== G6 THE CAP ====================================
Config.MaxGuiObjects = 3
reset()
buildGui()
readGui()
local guiEvt2 = evtOf('GUI')
checkTrue('G6 the cap is reported and the overflow is counted',
	guiEvt2 ~= nil and string.find(guiEvt2, 'over=0 ', 1, true) == nil,
	tostring(guiEvt2))
check('G6 the count reflects the cap', #guiRecords, 3)
checkTrue('G6 the overflow is a positive number',
	type(lastPut['g.over']) == 'number' and lastPut['g.over'] > 0,
	'over=' .. tostring(lastPut['g.over']))
Config.MaxGuiObjects = 99
reset()
buildGui()
readGui()

-- ========================== G7 MID-RUN ADDITIONS ==========================
-- A screen the game creates halfway through the shift has to be picked up, and
-- the pick-up has to reach the readout sweep as well as this reader.
reset()
readoutDirty = false
local late = add(pg, new('ScreenGui', 'LateScreen'))
checkTrue('G7 adding a screen sets the dirty flag', guiDirty == true,
	'DescendantAdded did not mark the tree dirty')
readGui()
checkTrue('G7 the late screen is a record after one poll',
	keyOf(late) ~= nil, 'it was never picked up')
checkTrue('G7 the rebuild also invalidates the readout sweep',
	readoutDirty == true,
	'a label added mid-shift would never be read for text')
checkTrue('G7 GMAP names the class of a screen',
	(string.find(evtOf('GMAP') or '', 'ScreenGui', 1, true) ~= nil), evtOf('GMAP'))

reset()
remove(pg, late)
checkTrue('G7 removing a screen sets the dirty flag', guiDirty == true,
	'DescendantRemoving did not mark the tree dirty')
reset()
readGui()
checkTrue('G7 the removed screen is gone from the records',
	keyOf(late) == nil, 'a destroyed screen is still being read')

-- ========================== G8 THE COUNTERS ===============================
reset()
readGui()
checkTrue('G8 every poll offers g.objects', #putsWithKey('g.objects') > 0, 'missing')
checkTrue('G8 every poll offers g.over', #putsWithKey('g.over') > 0, 'missing')
checkTrue('G8 every poll offers g.unreadable',
	#putsWithKey('g.unreadable') > 0, 'missing')
checkTrue('G8 every poll offers g.labels', #putsWithKey('g.labels') > 0, 'missing')

-- ========================== G9 THE READ IS CHEAP ==========================
-- The reader runs four times a second, and the whole argument for reading the
-- raw flag rather than the effective one is that the raw read is ONE property
-- access per object. So the accesses are COUNTED rather than the timing claimed.
--
-- Two different prices are pinned, and they are different on purpose: a REBUILD
-- pays a probe per candidate, which is what not guessing the class costs, and a
-- POLL pays exactly one access per record and nothing more -- no ancestor walk
-- and no second pcall.
FLAG_READS = 0
reset()
readGui()
check('G9 one poll reads exactly one flag per record', FLAG_READS, #guiRecords)

FLAG_READS = 0
buildGui()
local perObject = FLAG_READS / #guiRecords
checkTrue('G9 a rebuild pays one probe per object',
	perObject >= 1 and perObject < 2,
	'probes per object = ' .. tostring(perObject))
reset()
readGui()

-- ========================== G10 THE FLAG IS NOT THE VIEW ==================
-- Documented, deliberate, and pinned here so it cannot be quietly "fixed" into a
-- per-poll ancestor walk. A Visible=true label under a Visible=false Frame reads
-- true: the raw flag is what is read. What closes the gap for free is the
-- ScreenGui's own Enabled, which IS read, and G1 pins that.
hudFrame._visible = false
reset()
readGui()
check('G10 a Visible child under a hidden frame still reads true',
	seen(hudLabel), true)
check('G10 the frame it is hiding under reads false', seen(hudFrame), false)
check('G10 and the screen above both is unaffected', seen(hud), true)
hudFrame._visible = true

local report = table.concat(results, string.char(10))
if string.find(report, 'FAIL', 1, true) ~= nil and io ~= nil and io.stderr ~= nil then
	io.stderr:write(report .. string.char(10))
	os.exit(1)
end
return report
