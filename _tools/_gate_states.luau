--!nocheck
-- GENERATED by _tools/build_gate_test.py -- edit that file, not this one.
--
-- THE CORE GATE and the stats scan it gates are EXTRACTED from
-- _tools/TRG_original_recorder.luau. Everything else is mock: no Roblox API and
-- no DataModel instance is touched.

local results = {}
local function say(s) results[#results + 1] = tostring(s) end

local function check(name, got, want)
	local ok = (got == want)
	say((ok and 'PASS ' or 'FAIL ') .. name)
	if not ok then
		say('     got  [' .. tostring(got) .. ']')
		say('     want [' .. tostring(want) .. ']')
	end
end

local function checkTrue(name, cond, why)
	say((cond and 'PASS ' or 'FAIL ') .. name)
	if not cond then say('     ' .. why) end
end

-- ============================ THE MOCK PLANT ==============================
-- A ValueObject is anything with a Name, a Value and `IsA('ValueBase')` true.
-- A container answers `GetChildren` and `FindFirstChild`. That is the whole of
-- the surface the extracted code touches, which is itself worth stating: if the
-- recorder ever reaches for a third method, this harness stops compiling rather
-- than quietly testing something else.
local function mkValue(name, value)
	return {
		Name = name,
		Value = value,
		IsA = function(self, c) return c == 'ValueBase' end,
		GetChildren = function(self) return {} end,
	}
end

local function mkOther(name)
	-- Present, named, and deliberately NOT a ValueObject: the recorder has to
	-- tolerate this without raising, because
	-- `MainData:FindFirstChild('GameActive').Value` on a Folder is exactly the
	-- crash that would take the whole recording with it.
	--
	-- The __index that RAISES is the whole of the mock's fidelity, and it was
	-- added because its absence hid a mutation. Without it, `flag.Value` on this
	-- table answers nil -- so a recorder that dropped the `IsA('ValueBase')` guard
	-- sailed through `if flag.Value ~= true then return false end` and the harness
	-- called the crash-free path correct. Roblox does not answer nil there: it
	-- raises "Value is not a valid member of Folder", inside the poll, on the first
	-- poll, with no receipt. A generous stub is a stub that hides a crash.
	return setmetatable({
		Name = name,
		IsA = function(self, c) return false end,
		GetChildren = function(self) return {} end,
	}, {
		__index = function(_, key)
			error(key .. ' is not a valid member of Folder', 2)
		end,
	})
end

local function mkFolder(name, kids)
	return {
		Name = name,
		IsA = function(self, c) return false end,
		GetChildren = function(self) return kids end,
		FindFirstChild = function(self, n)
			for _, k in ipairs(kids) do
				if k.Name == n then return k end
			end
			return nil
		end,
	}
end

-- ============================ THE HARNESS WIRING ==========================
-- `put` / `putText` are the recorder's two writers; here they are recorders
-- themselves. `last` is the change detector the gate has to keep its hands off,
-- and `statsSeen` is the manifest the STATADD/STATDEL bookkeeping is built from.
local wrote, texts, events = {}, {}, {}
local last, statsSeen, changed = {}, {}, {}

local function put(key, value)
	-- Modelled on the shipped `put`: it is change-gated, so the same value twice
	-- is one write. Reproduced here because the gate's whole failure mode is a
	-- value that was written once too often, and a mock that recorded every call
	-- would hide it.
	if last[key] == value then return end
	last[key] = value
	wrote[#wrote + 1] = key .. '=' .. tostring(value)
end

local function putText(key, text)
	if text == nil then return end
	if last[key] == text then return end
	last[key] = text
	texts[#texts + 1] = key .. ' ' .. tostring(text)
end

local function emitEvt(kind, rest) events[#events + 1] = kind .. ' ' .. tostring(rest) end

local Stats -- the mock Workspace.Stats, reassigned by each scenario
local Workspace = {
	FindFirstChild = function(self, n)
		if n == 'Stats' then return Stats end
		return nil
	end,
}
local MainData = nil

-- `keys` and `has` read the recording tables, so they belong up here with them.
local function keys(n) return table.concat(wrote, ' ') end

local function has(list, needle)
	for _, s in ipairs(list) do
		if s == needle then return true end
	end
	return false
end

-- ============ EXTRACTED: THE CORE GATE (shipped bytes) ============
local coreLive = false

-- Opens the gate if the game says the core is up, and answers whether it is open.
-- Read from the game's own flag and not from a temperature, because the
-- temperature is the thing being gated: deriving the gate from it would make the
-- recorder's first reading depend on a value it has already decided not to trust.
local function coreGateOpen()
	if coreLive then return true end
	-- Re-fetched here rather than merely read, and the difference is the whole
	-- point of the function being callable from two places. `MainData` is captured
	-- once at load, so a recorder injected before `Workspace.Stats` exists holds a
	-- nil until some OTHER reader happens to refresh it -- which would make this
	-- gate's behaviour depend on the stats scan having run first, the one
	-- dependency having two callers was meant to remove. Found by the gate
	-- harness's G10, which is the scenario a run injected during the boot exactly
	-- hits.
	if MainData == nil then MainData = Workspace:FindFirstChild('Stats') end
	local flag = MainData and MainData:FindFirstChild('GameActive')
	if flag == nil or not flag:IsA('ValueBase') then return false end
	if flag.Value ~= true then return false end
	coreLive = true
	-- Announced as an event, so the file itself carries the fact that the readings
	-- below this point are the live ones. A reader who finds the batch that
	-- follows can now tell "the core came on here" from "the core was on before
	-- the recorder arrived" without re-deriving it from a temperature.
	emitEvt('COREGATE', 'Stats.GameActive went true; the core is fully on and the'
		.. ' reactor readings start from this poll')
	return true
end

-- Whether a Stats path is one of the reactor's own readings. The test is on the
-- container `Core` rather than on a list of leaf names, because a list is a thing
-- a rename escapes silently: TemperatureVal, PressureVal, RadiationVal, OutputVal,
-- HDEFVal and BreachVal all live under it, and anything added there later is
-- covered without this file being edited.
local function isCoreStat(path)
	return path == 'Core' or path:sub(1, 5) == 'Core.'
end

-- ============ EXTRACTED: readStats (shipped bytes) ===============
local function readStats()
	if MainData == nil then MainData = Workspace:FindFirstChild('Stats') end
	if MainData == nil then return end
	-- Called here as well as in readReactor even though pollOnce always runs
	-- readReactor first. The gate is idempotent and latches, so the second call is
	-- free; what it buys is that neither reader depends on the other having run,
	-- and this file has lost a day to exactly that kind of ordering assumption.
	coreGateOpen()
	local seen = {}
	local function scan(inst, prefix)
		for _, d in ipairs(inst:GetChildren()) do
			local path = prefix .. d.Name
			seen[path] = true
			if d:IsA('ValueBase') then
				-- HELD BACK until the core is on, and "held back" means not written at
				-- all: `last` is not touched either, so the first sample after the gate
				-- opens arrives as a NEW key and the ignition shows up in the file as
				-- its own batch. Writing the pre-boot zero into `last` and then letting
				-- the real reading differ from it would record the same fact as one
				-- line of noise inside a run of changes, which is how it gets missed.
				--
				-- The traversal is NOT gated: `seen[path]` is set above either way, so a
				-- held-back key is still a key the STATADD/STATDEL announcement knows
				-- about and the goings and comings of the container are still recorded
				-- exactly as before.
				if coreLive or not isCoreStat(path) then
					local v = d.Value
					local t = type(v)
					if t == 'number' or t == 'boolean' then
						put('s.' .. path, v)
					elseif v ~= nil then
						-- A StringValue, or a type with no space-free rendering.
						putText('s.' .. path, tostring(v))
					end
				end
			end
			if #d:GetChildren() > 0 then scan(d, path .. '.') end
		end
	end
	scan(MainData, '')
	for path in pairs(statsSeen) do
		if not seen[path] then
			emitEvt('STATDEL', path)
			last['s.' .. path] = nil
			last['x.s.' .. path] = nil
		end
	end
	for path in pairs(seen) do
		if not statsSeen[path] then emitEvt('STATADD', path) end
	end
	statsSeen = seen
end

-- ---------------------------------------------------------------- helpers --
-- `reset` is defined HERE, below the extracted gate, and that placement is
-- load-bearing rather than tidy. It used to sit above it, where `coreLive` is not
-- yet in scope -- so `coreLive = false` was a write to a GLOBAL while the gate
-- read its own LOCAL of the same name, the latch was never cleared between
-- scenarios, and G5/G7/G9/G10 failed against a recorder that was correct. A
-- harness whose reset silently does nothing is a harness that reports the state
-- left by whichever scenario ran last.
local function reset()
	Stats = mkFolder('Stats', {})
	MainData = nil
	wrote, texts, events = {}, {}, {}
	last, statsSeen, changed = {}, {}, {}
	coreLive = false
end

-- ===================== G1 the gate does not open on a guess =================
-- Three ways the flag can fail to be the flag, and all three must leave the gate
-- closed. `false` is the real one on a cold reactor; the other two are the ones a
-- NameError would be caught by in a real run, and catching them here is what says
-- the gate cannot take the recorder down with it.

reset()
Stats = mkFolder('Stats', { mkValue('GameActive', false) })
MainData = Workspace:FindFirstChild('Stats')
coreGateOpen()
check('G1 a false flag leaves the gate closed', coreLive, false)

reset()
Stats = mkFolder('Stats', {})
MainData = Workspace:FindFirstChild('Stats')
coreGateOpen()
check('G1 a MISSING flag leaves the gate closed', coreLive, false)

reset()
Stats = mkFolder('Stats', { mkOther('GameActive') })
MainData = Workspace:FindFirstChild('Stats')
local okCall = pcall(coreGateOpen)
check('G1 a same-named NON-ValueObject is survived', okCall, true)
check('G1 and it leaves the gate closed', coreLive, false)

reset()
Stats = mkFolder('Stats', { mkValue('GameActive', true) })
MainData = Workspace:FindFirstChild('Stats')
check('G1 a true flag opens it', coreGateOpen(), true)
check('G1 and the state says so too', coreLive, true)

-- ===================== G2 the gate LATCHES =================================
-- Not an optimisation: the cold-trip arm reads `m.temp` below LowTripF AFTER the
-- shutdown, so a gate that reopened when GameActive went false would silence the
-- readings the seal rule is made of.

reset()
Stats = mkFolder('Stats', { mkValue('GameActive', true) })
MainData = Workspace:FindFirstChild('Stats')
coreGateOpen()
Stats = mkFolder('Stats', { mkValue('GameActive', false) })
MainData = Workspace:FindFirstChild('Stats')
check('G2 the gate stays open when the flag goes back to false', coreGateOpen(), true)
check('G2 and coreLive is not reset either', coreLive, true)

-- ===================== G3 what counts as a core reading ====================
-- The container and its children, and nothing that merely starts with the same
-- letters -- `CoreStuff` and `Reactor.Core` are the two near-misses a prefix test
-- written carelessly would swallow.

check('G3 the container itself is a core stat', isCoreStat('Core'), true)
check('G3 a child of it is one', isCoreStat('Core.TemperatureVal'), true)
check('G3 a deeper child is one too', isCoreStat('Core.A.B'), true)
check('G3 a longer name is NOT', isCoreStat('CoreStuff'), false)
check('G3 a name that ends in Core is NOT', isCoreStat('Reactor.Core'), false)
check('G3 a prefix of the name is NOT', isCoreStat('Cor'), false)
check('G3 an unrelated stat is NOT', isCoreStat('GameActive'), false)

-- ===================== G4 held means NOT WRITTEN ===========================
-- The check this file exists for. A closed gate must leave the value out of
-- `last` entirely, or the ignition is swallowed on the poll it happens.

reset()
Stats = mkFolder('Stats', {
	mkValue('GameActive', false),
	mkValue('ActiveQPUs', 4),
	mkFolder('Core', { mkValue('TemperatureVal', 0), mkValue('PressureVal', 20) }),
})
MainData = Workspace:FindFirstChild('Stats')
readStats()

checkTrue('G4 the core temperature is not written while the gate is closed',
	not has(wrote, 's.Core.TemperatureVal=0'), 'wrote: ' .. keys(0))
checkTrue('G4 the core pressure is not either',
	not has(wrote, 's.Core.PressureVal=20'), 'wrote: ' .. keys(0))
check('G4 and it is NOT sitting in `last` as an unknown-key marker',
	last['s.Core.TemperatureVal'], nil)

-- The other half of the same rule, and the half that is easy to throw away by
-- accident: everything OUTSIDE Core still has to be written, because that is
-- where the boot sequence itself is recorded.
checkTrue('G4 a non-core stat IS still written',
	has(wrote, 's.ActiveQPUs=4'), 'wrote: ' .. keys(0))
checkTrue('G4 and so is the flag the gate reads',
	has(wrote, 's.GameActive=false'), 'wrote: ' .. keys(0))

-- ===================== G5 the ignition arrives as a NEW key ================
-- The same reading, the same value, before and after -- and it must still be
-- written, because the closed poll never put it in `last`. A "filter, don't hold"
-- implementation fails here and nowhere else.

reset()
Stats = mkFolder('Stats', {
	mkValue('GameActive', false),
	mkFolder('Core', { mkValue('TemperatureVal', 0) }),
})
MainData = Workspace:FindFirstChild('Stats')
readStats()
checkTrue('G5 the pre-boot poll wrote nothing about the core',
	not has(wrote, 's.Core.TemperatureVal=0'), 'wrote: ' .. keys(0))

Stats = mkFolder('Stats', {
	mkValue('GameActive', true),
	mkFolder('Core', { mkValue('TemperatureVal', 0) }),
})
MainData = Workspace:FindFirstChild('Stats')
readStats()
checkTrue('G5 the SAME value is written once the gate opens',
	has(wrote, 's.Core.TemperatureVal=0'), 'wrote: ' .. keys(0))
check('G5 and it is now in `last` for the next change to compare against',
	last['s.Core.TemperatureVal'], 0)

-- ===================== G6 the gate opens from the stats scan alone =========
-- `pollOnce` runs readReactor first, so in the shipped loop the gate is already
-- open by the time readStats runs. The claim here is that readStats does not
-- DEPEND on that: it calls the gate itself, and a reader that only ran the scan
-- still gets the core readings.

reset()
Stats = mkFolder('Stats', {
	mkValue('GameActive', true),
	mkFolder('Core', { mkValue('TemperatureVal', 9420) }),
})
MainData = Workspace:FindFirstChild('Stats')
readStats()
check('G6 readStats opens the gate by itself', coreLive, true)
checkTrue('G6 and writes the core reading in the same poll',
	has(wrote, 's.Core.TemperatureVal=9420'), 'wrote: ' .. keys(0))

-- ===================== G7 the announcement fires ONCE ======================
-- A COREGATE line per poll would be two thousand lines of noise in a file whose
-- whole design is that a line means something changed.

reset()
Stats = mkFolder('Stats', {
	mkValue('GameActive', true),
	mkFolder('Core', { mkValue('TemperatureVal', 100) }),
})
MainData = Workspace:FindFirstChild('Stats')
readStats(); readStats(); readStats()
local n = 0
for _, e in ipairs(events) do
	if string.sub(e, 1, 8) == 'COREGATE' then n = n + 1 end
end
check('G7 COREGATE is announced exactly once', n, 1)

-- ===================== G8 the manifest still sees a held key ===============
-- The gate holds the VALUE, not the KEY. `seen` is filled before the gate is
-- consulted, so a held-back path is still part of the manifest -- which is what
-- keeps the STATDEL sweep from announcing that the whole Core container
-- disappeared on the poll before the gate opened.

reset()
Stats = mkFolder('Stats', {
	mkValue('GameActive', false),
	mkFolder('Core', { mkValue('TemperatureVal', 0) }),
})
MainData = Workspace:FindFirstChild('Stats')
readStats()
check('G8 the held path is in statsSeen', statsSeen['Core.TemperatureVal'], true)
local del = false
for _, e in ipairs(events) do
	if string.sub(e, 1, 8) == 'STATDEL ' then del = true end
end
check('G8 and nothing was announced as deleted', del, false)

-- ===================== G9 a string under Core is held too ==================
-- `putText` is a second writer with its own path through the gate, and a gate
-- that only covered `put` would let the pre-boot error text out.

reset()
Stats = mkFolder('Stats', {
	mkValue('GameActive', false),
	mkFolder('Core', { mkValue('Status', 'STANDBY') }),
})
MainData = Workspace:FindFirstChild('Stats')
readStats()
check('G9 the core string is held back', #texts, 0)

Stats = mkFolder('Stats', {
	mkValue('GameActive', true),
	mkFolder('Core', { mkValue('Status', 'STANDBY') }),
})
MainData = Workspace:FindFirstChild('Stats')
readStats()
check('G9 and written once the gate opens', texts[1], 's.Core.Status STANDBY')

-- ===================== G10 the gate reads Stats FRESH ======================
-- `MainData` is captured once at load time and re-fetched if it is nil. A Stats
-- folder that did not exist when the recorder was injected has to be picked up,
-- or the gate would stay shut for the whole run on a shift that starts early.

reset()
Stats = nil
MainData = nil
check('G10 a missing Stats folder is not fatal and not open', coreGateOpen(), false)

Stats = mkFolder('Stats', { mkValue('GameActive', true) })
check('G10 the gate opens once the folder appears', coreGateOpen(), true)

-- ------------------------------------------------------ report + exit ------
-- The exit is not decoration: run_tests.sh and selftest_gate_test.py both gate on
-- the process code, and a chunk that returns a report full of FAILs while exiting
-- 0 reads as green to every caller. (The first version of this harness did exactly
-- that, which made the mutation run report "stayed GREEN" for six mutations that
-- did in fact turn it red. A suite whose failure is invisible to `$?` is only
-- half a suite.)
local report = table.concat(results, string.char(10))

if string.find(report, 'FAIL', 1, true) ~= nil and io ~= nil and io.stderr ~= nil then
	io.stderr:write(report .. string.char(10))
	os.exit(1)
end
return report
